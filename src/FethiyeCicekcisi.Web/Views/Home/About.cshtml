@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = "Hakkımızda";
    ViewData["Description"] = "Yonca Çiçekçilik'in hikayesi — Fethiye'de taze çiçek, el bağlaması buket ve aranjman özeniyle çalışan küçük bir atölye.";
}

<section class="bg-beige">
    <div class="container text-center" style="padding-top:5rem;padding-bottom:5rem">
        <p class="section-tag">@L["Hikayemiz"]</p>
        <h1 class="section-title mb-3">@Html.Raw(L["Küçük bir atölye,&lt;br&gt;&lt;em&gt;büyük bir özen&lt;/em&gt;"])</h1>
        <p class="text-muted mx-auto" style="max-width:520px;font-size:.95rem;font-weight:300">@L["Taze çiçekler, özenli aranjmanlar — Fethiye'nin her köşesine aynı gün teslimat."]</p>
    </div>
</section>

<div class="container py-5" style="max-width:720px">
    <p class="mb-4" style="font-size:1.05rem;line-height:1.9;font-weight:300">@L["Yonca Çiçekçilik, taze ve kaliteli çiçekleri herkesin erişebileceği fiyatlarla sunmak amacıyla kurulmuş bir çiçekçilik markasıdır. Her buketimizde şıklığı ve tazeliği bir arada sunmayı hedefliyoruz."]</p>
    <p class="mb-5" style="font-size:1.05rem;line-height:1.9;font-weight:300">@L["Ürünlerimiz, titizlikle seçilmiş taze çiçeklerden hazırlanır ve aynı gün içinde teslim edilir. Müşteri memnuniyeti en büyük önceliğimizdir."]</p>

    <hr class="mx-auto mb-5" style="max-width:80px;border-color:var(--kw-border);opacity:1" />

    <div class="row g-5 mt-1">
        <div class="col-md-4 text-center reveal">
            <i class="bi bi-flower1 fs-2 mb-3 d-block" style="color:var(--kw-accent)"></i>
            <h6 class="fw-500 mb-2" style="font-family:var(--font-serif);font-size:1.1rem">@L["Taze Çiçekler"]</h6>
            <p class="text-muted" style="font-size:.86rem">@L["Özenle seçilmiş taze çiçekler ve işçilik"]</p>
        </div>
        <div class="col-md-4 text-center reveal" style="transition-delay:.1s">
            <i class="bi bi-truck fs-2 mb-3 d-block" style="color:var(--kw-accent)"></i>
            <h6 class="fw-500 mb-2" style="font-family:var(--font-serif);font-size:1.1rem">@L["Aynı Gün Teslimat"]</h6>
            <p class="text-muted" style="font-size:.86rem">@L["Fethiye içi hızlı ve özenli teslimat"]</p>
        </div>
        <div class="col-md-4 text-center reveal" style="transition-delay:.2s">
            <i class="bi bi-arrow-counterclockwise fs-2 mb-3 d-block" style="color:var(--kw-accent)"></i>
            <h6 class="fw-500 mb-2" style="font-family:var(--font-serif);font-size:1.1rem">@L["Kolay İade"]</h6>
            <p class="text-muted" style="font-size:.86rem">@L["Sorunlu teslimatlarda kolay çözüm"]</p>
        </div>
    </div>
</div>
