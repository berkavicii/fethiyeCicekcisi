@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = "İletişim";
    ViewData["Description"] = "Yonca Çiçekçilik ile iletişime geçin — Fethiye'deki mağazamızdan bilgi alın veya siparişinizle ilgili bize ulaşın.";
}

<section class="bg-beige">
    <div class="container text-center" style="padding-top:5rem;padding-bottom:5rem">
        <p class="section-tag">@L["İletişim"]</p>
        <h1 class="section-title mb-3">@Html.Raw(L["Size nasıl &lt;em&gt;yardımcı&lt;/em&gt; olabiliriz?"])</h1>
        <p class="text-muted" style="font-weight:300">@L["Bizimle iletişime geçin — genellikle aynı gün dönüş yaparız."]</p>
    </div>
</section>

<div class="container py-5">
    <div class="row g-5 justify-content-center">
        <div class="col-md-5">
            <h5 class="fw-600 mb-4">@L["Bize Yazın"]</h5>
            @if (TempData["ContactSuccess"] != null)
            {
                <div class="alert alert-success mb-4" style="font-size:.85rem">
                    @L["Mesajınız alındı, en kısa sürede dönüş yapacağız."]
                </div>
            }
            <form method="post" asp-controller="Home" asp-action="Contact">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label" style="font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em">@L["Ad Soyad"]</label>
                    <input name="name" class="form-control form-control-kw" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" style="font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em">@L["E-posta"]</label>
                    <input name="email" type="email" class="form-control form-control-kw" required />
                </div>
                <div class="mb-4">
                    <label class="form-label" style="font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em">@L["Mesaj"]</label>
                    <textarea name="message" rows="5" class="form-control form-control-kw" required></textarea>
                </div>
                <button type="submit" class="btn-kw-dark border-0">@L["Gönder"]</button>
            </form>
        </div>

        <div class="col-md-4">
            <h5 class="fw-600 mb-4">@L["İletişim Bilgileri"]</h5>
            <ul class="list-unstyled" style="font-size:.9rem;line-height:2">
                <li><i class="bi bi-envelope me-2"></i><a href="mailto:info@fethiyecicekcisi.com">info@fethiyecicekcisi.com</a></li>
                <li><i class="bi bi-instagram me-2"></i><a href="https://instagram.com/fethiyecicekcisi" target="_blank">@@fethiyecicekcisi</a></li>
            </ul>
            <p class="text-muted mt-3" style="font-size:.85rem">
                @L["Sipariş ve ürün sorularınız için Instagram DM veya e-posta yoluyla ulaşabilirsiniz."]
                @L["Mesaj saatlerimiz: Haftaiçi 09:00–18:00"]
            </p>
        </div>
    </div>
</div>
