@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = "Ödeme Başarısız";
}

<div class="container py-5 text-center" style="max-width:500px">
    <div class="mb-4">
        <i class="bi bi-x-circle-fill text-danger" style="font-size:4rem"></i>
    </div>
    <h2 class="section-title mb-2">@L["Ödeme Başarısız"]</h2>
    <p class="text-muted mb-5">@L["Ödeme işleminiz tamamlanamadı. Lütfen tekrar deneyin veya farklı bir ödeme yöntemi kullanın."]</p>

    <div class="d-flex gap-3 justify-content-center">
        <a asp-controller="Order" asp-action="Checkout" class="btn-kw-outline">@L["Tekrar Dene"]</a>
        <a asp-controller="Home" asp-action="Index" class="btn-kw-dark">@L["Ana Sayfaya Dön"]</a>
    </div>
</div>
