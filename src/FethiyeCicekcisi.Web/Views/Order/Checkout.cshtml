@using FethiyeCicekcisi.Core.Enums
@using Microsoft.Extensions.Localization
@model FethiyeCicekcisi.Web.ViewModels.Order.CheckoutViewModel
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = "Ödeme";
    var minDateAttr = Model.MinDeliveryDate.ToString("yyyy-MM-dd");
}

<div class="container py-5">
    <p class="section-tag mb-2">@L["Son Adım"]</p>
    <h1 class="section-title mb-2">@Html.Raw(L["Siparişi <em>tamamla</em>"])</h1>
    <p class="text-muted mb-5" style="font-size:.88rem">@L["Üyelik gerekmez — bilgilerinizi doldurun, sipariş numaranız e-postanıza gönderilsin."]</p>

    @if (User.Identity?.IsAuthenticated != true)
    {
        <div class="checkout-block reveal mb-5" id="guestGate" style="max-width:560px">
            <h5 class="checkout-block-title mb-3">@L["Nasıl devam etmek istersiniz?"]</h5>
            <p class="text-muted mb-4" style="font-size:.85rem">
                @L["Üye girişi yaparsanız bilgileriniz otomatik doldurulur ve siparişlerinizi hesabınızdan takip edebilirsiniz. Üye olmadan da devam edebilirsiniz."]
            </p>
            <div class="d-flex flex-column flex-sm-row gap-3">
                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/siparis/odeme"
                   class="btn-kw-dark border-0 text-center flex-fill">@L["Üye Girişi Yap"]</a>
                <button type="button" id="guestContinueBtn" class="btn-kw-outline flex-fill">@L["Üye Olmadan Devam Et"]</button>
            </div>
        </div>
    }

    <form asp-controller="Order" asp-action="Checkout" method="post" id="checkoutForm" class="@(User.Identity?.IsAuthenticated != true ? "d-none" : "")">
        @Html.AntiForgeryToken()
        <div class="row g-5">
            <div class="col-lg-7">
                <!-- Gönderen -->
                <div class="checkout-block reveal">
                    <h5 class="checkout-block-title"><span class="checkout-step">01</span> @L["Bilgileriniz"] <small class="text-muted" style="font-size:.72rem">(@L["siparişi veren"])</small></h5>
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="SenderName" class="form-label fw-500" style="font-size:.82rem"></label>
                            <input asp-for="SenderName" class="form-control form-control-kw" />
                            <span asp-validation-for="SenderName" class="text-danger" style="font-size:.78rem"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SenderPhone" class="form-label fw-500" style="font-size:.82rem"></label>
                            <input asp-for="SenderPhone" class="form-control form-control-kw" />
                            <span asp-validation-for="SenderPhone" class="text-danger" style="font-size:.78rem"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SenderEmail" class="form-label fw-500" style="font-size:.82rem"></label>
                            <input asp-for="SenderEmail" class="form-control form-control-kw" type="email" />
                            <span asp-validation-for="SenderEmail" class="text-danger" style="font-size:.78rem"></span>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="IsAnonymousSender" class="form-check-input" type="checkbox" />
                                <label asp-for="IsAnonymousSender" class="form-check-label" style="font-size:.85rem">
                                    @L["Gönderen bilgim gizli kalsın"]
                                    <small class="text-muted d-block" style="font-size:.75rem">@L["Adınız kartta ve teslimatta alıcıya gösterilmez."]</small>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Alıcı -->
                <div class="checkout-block reveal">
                    <h5 class="checkout-block-title"><span class="checkout-step">02</span> @L["Alıcı Bilgileri"] <small class="text-muted" style="font-size:.72rem">(@L["çiçeğin teslim edileceği kişi"])</small></h5>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-500" style="font-size:.82rem">@L["Teslimat Yöntemi"]</label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input name="DeliveryType" id="dtTeslimat" class="form-check-input" type="radio" value="@((int)DeliveryType.Teslimat)" checked="@(Model.DeliveryType == DeliveryType.Teslimat)" />
                                    <label for="dtTeslimat" class="form-check-label" style="font-size:.85rem">@L["Adrese Teslimat"]</label>
                                </div>
                                <div class="form-check">
                                    <input name="DeliveryType" id="dtGelAl" class="form-check-input" type="radio" value="@((int)DeliveryType.GelAl)" checked="@(Model.DeliveryType == DeliveryType.GelAl)" />
                                    <label for="dtGelAl" class="form-check-label" style="font-size:.85rem">
                                        @L["Mağazadan Gel Al"] <span class="text-muted">(@L["ücretsiz"])</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="RecipientFirstName" class="form-label fw-500" style="font-size:.82rem"></label>
                            <input asp-for="RecipientFirstName" class="form-control form-control-kw" />
                            <span asp-validation-for="RecipientFirstName" class="text-danger" style="font-size:.78rem"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="RecipientLastName" class="form-label fw-500" style="font-size:.82rem"></label>
                            <input asp-for="RecipientLastName" class="form-control form-control-kw" />
                            <span asp-validation-for="RecipientLastName" class="text-danger" style="font-size:.78rem"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="RecipientPhone" class="form-label fw-500" style="font-size:.82rem"></label>
                            <input asp-for="RecipientPhone" class="form-control form-control-kw" />
                            <span asp-validation-for="RecipientPhone" class="text-danger" style="font-size:.78rem"></span>
                        </div>
                        <div id="pickupNotice" class="col-12" style="display:none">
                            <div class="p-3" style="background:var(--kw-light);border-radius:var(--radius-sm);font-size:.85rem">
                                <strong>@L["Mağazadan teslim alınacak adres:"]</strong><br />
                                Yonca Çiçekçilik — Tuzla, İnönü Blv. 125/c, 48300 Fethiye/Muğla
                            </div>
                        </div>
                        <div id="deliveryFields" class="col-12 row g-3">
                            <div class="col-md-6">
                                <label asp-for="DeliveryZoneId" class="form-label fw-500" style="font-size:.82rem"></label>
                                <select asp-for="DeliveryZoneId" id="zoneSelect" class="form-select form-control-kw">
                                    <option value="">@L["Bölge seçiniz..."]</option>
                                    @foreach (var zone in Model.Zones)
                                    {
                                        <option value="@zone.Id" data-fee="@zone.Fee.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                            @zone.City — @zone.Name (+@zone.Fee.ToString("N0") ₺)
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="DeliveryZoneId" class="text-danger" style="font-size:.78rem"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="RecipientAddressLine1" class="form-label fw-500" style="font-size:.82rem"></label>
                                <input asp-for="RecipientAddressLine1" class="form-control form-control-kw" placeholder="@L["Mahalle, sokak, no, daire..."]" />
                                <span asp-validation-for="RecipientAddressLine1" class="text-danger" style="font-size:.78rem"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="RecipientAddressLine2" class="form-label fw-500" style="font-size:.82rem"></label>
                                <input asp-for="RecipientAddressLine2" class="form-control form-control-kw" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Teslimat -->
                <div class="checkout-block reveal">
                    <h5 class="checkout-block-title"><span class="checkout-step">03</span> @L["Teslimat & Kart Notu"]</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="DeliveryDate" class="form-label fw-500" style="font-size:.82rem"></label>
                            <input asp-for="DeliveryDate" asp-format="{0:yyyy-MM-dd}" type="date" min="@minDateAttr" class="form-control form-control-kw" />
                            <small class="text-muted" style="font-size:.75rem">
                                @(Model.MinDeliveryDate == DateOnly.FromDateTime(DateTime.Now)
                                    ? L["Sepetinizdeki ürünler aynı gün teslimata uygun. 🌸"]
                                    : L["Sepetinizdeki ürünler için en erken teslimat yarın."])
                            </small>
                            <span asp-validation-for="DeliveryDate" class="text-danger d-block" style="font-size:.78rem"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DeliveryTimeSlot" class="form-label fw-500" style="font-size:.82rem"></label>
                            <select asp-for="DeliveryTimeSlot" class="form-select form-control-kw">
                                <option value="0">@L["Saat aralığı seçiniz..."]</option>
                                <option value="1">09:00 – 13:00</option>
                                <option value="2">13:30 – 20:00</option>
                            </select>
                            <span asp-validation-for="DeliveryTimeSlot" class="text-danger d-block" style="font-size:.78rem"></span>
                        </div>
                        @if (Model.AnyItemAllowsMessageCard)
                        {
                            <div class="col-12">
                                <label asp-for="CardMessage" class="form-label fw-500" style="font-size:.82rem"></label>
                                <textarea asp-for="CardMessage" class="form-control form-control-kw card-message-input" rows="3" maxlength="200"
                                          placeholder="@L["\"İyi ki varsın...\" — çiçekle birlikte gönderilecek not (boş bırakılabilir)"]"></textarea>
                                <small class="text-muted" style="font-size:.75rem"><span id="cardMsgCount">0</span>/200 @L["karakter"]</small>
                                <span asp-validation-for="CardMessage" class="text-danger d-block" style="font-size:.78rem"></span>
                            </div>
                        }
                        <div class="col-12">
                            <label asp-for="Notes" class="form-label fw-500" style="font-size:.82rem"></label>
                            <textarea asp-for="Notes" class="form-control form-control-kw" rows="2"
                                      placeholder="@L["Adres tarifi, kapı kodu vb."]"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="col-lg-5">
                <div class="order-summary-box reveal">
                    <h5 class="mb-4" style="font-family:var(--font-serif)">@L["Sipariş Özeti"]</h5>
                    @foreach (var item in Model.CartItems)
                    {
                        <div class="d-flex gap-3 mb-3">
                            <img src="@(item.Product?.MainImageUrl ?? "/images/products/placeholder.jpg")"
                                 style="width:60px;height:75px;object-fit:cover;background:var(--kw-light);border-radius:var(--radius-sm)" alt="@item.Product?.GetLocalizedName()"
                                 onerror="this.src='/images/products/placeholder.jpg'" />
                            <div class="flex-grow-1">
                                <div style="font-size:.85rem;font-weight:500">@item.Product?.GetLocalizedName()</div>
                                @if (!string.IsNullOrEmpty(item.ProductVariant?.Size))
                                {
                                    <small class="text-muted">@item.ProductVariant.Size</small>
                                }
                                <div class="d-flex justify-content-between mt-1">
                                    <small class="text-muted">× @item.Quantity</small>
                                    <small class="fw-500">@item.TotalPrice.ToString("N2") ₺</small>
                                </div>
                            </div>
                        </div>
                    }
                    <hr />

                    <!-- Promosyon kodu -->
                    <div class="mb-3">
                        <label asp-for="PromoCode" class="form-label fw-500" style="font-size:.82rem"></label>
                        <div class="input-group">
                            <input asp-for="PromoCode" class="form-control form-control-kw" placeholder="@L["Kodunuz varsa girin"]"
                                   style="text-transform:uppercase;font-family:monospace" />
                            <button type="button" class="btn btn-outline-dark" id="promoCheckBtn" style="font-size:.78rem">@L["Uygula"]</button>
                        </div>
                        <small id="promoMsg" class="d-block mt-1" style="font-size:.78rem"></small>
                        <span asp-validation-for="PromoCode" class="text-danger d-block" style="font-size:.78rem"></span>
                    </div>
                    <hr />

                    <div class="d-flex justify-content-between mb-2" style="font-size:.9rem">
                        <span>@L["Ara Toplam"]</span>
                        <span id="sumSubtotal" data-value="@Model.SubTotal.ToString(System.Globalization.CultureInfo.InvariantCulture)">@Model.SubTotal.ToString("N2") ₺</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2" style="font-size:.9rem">
                        <span>@L["Teslimat (bölge)"]</span>
                        <span id="sumShipping">@L["Bölge seçiniz"]</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3" style="font-size:.9rem;display:none!important" id="discountRow">
                        <span style="color:var(--kw-sage)">@L["İndirim"]</span>
                        <span id="sumDiscount" style="color:var(--kw-sage)">−0,00 ₺</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between mb-4">
                        <span class="fw-600">@L["Toplam"]</span>
                        <span class="fw-600" id="sumTotal">@Model.SubTotal.ToString("N2") ₺</span>
                    </div>

                    @{
                        var distanceSalesUrl = Url.Action("DistanceSalesContract", "Legal");
                        var cancellationUrl = Url.Action("CancellationRefundPolicy", "Legal");
                        var distanceSalesLink = "<a href=\"" + distanceSalesUrl + "\" target=\"_blank\">" + L["Mesafeli Satış Sözleşmesi'ni"] + "</a>";
                        var cancellationLink = "<a href=\"" + cancellationUrl + "\" target=\"_blank\">" + L["İptal, İade ve Değişim Politikası'nı"] + "</a>";
                        var agreementHtml = string.Format(L["Ön bilgilendirme koşullarını, {0} ve {1} okudum, kabul ediyorum."].Value, distanceSalesLink, cancellationLink);
                    }
                    <div class="form-check mb-3">
                        <input asp-for="AgreeToDistanceSalesContract" class="form-check-input" type="checkbox" />
                        <label class="form-check-label" for="AgreeToDistanceSalesContract" style="font-size:.83rem">
                            @Html.Raw(agreementHtml)
                        </label>
                        <span asp-validation-for="AgreeToDistanceSalesContract" class="text-danger d-block" style="font-size:.78rem"></span>
                    </div>

                    <button type="submit" class="btn-kw-dark d-block w-100 border-0">
                        @L["Ödeme Yap"]
                    </button>
                    <p class="text-muted text-center mt-3" style="font-size:.75rem">
                        <i class="bi bi-lock me-1"></i> @L["Güvenli ödeme PayTR ile sağlanmaktadır."]
                    </p>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // "Üye Olmadan Devam Et" — misafir kapısını kapatıp asıl formu açar. Form zaten
        // sunucu tarafında üyeliksiz kabul ediyor, bu yalnızca ilk seçim adımının UI'ı.
        (function () {
            const btn = document.getElementById('guestContinueBtn');
            const gate = document.getElementById('guestGate');
            const form = document.getElementById('checkoutForm');
            if (!btn || !gate || !form) return;
            btn.addEventListener('click', function () {
                gate.classList.add('d-none');
                form.classList.remove('d-none');
                form.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        })();

        // Kart mesajı karakter sayacı
        (function () {
            const textarea = document.getElementById('CardMessage');
            const counter = document.getElementById('cardMsgCount');
            if (!textarea || !counter) return;
            const update = () => counter.textContent = textarea.value.length;
            textarea.addEventListener('input', update);
            update();
        })();

        // Teslimat yöntemi (adrese teslim / gel al) + bölge ücreti + promosyon indirimi
        // ile canlı toplam. Görsel önizlemedir; asıl tutar her zaman sunucuda yeniden hesaplanır.
        (function () {
            const subTotal = parseFloat(document.getElementById('sumSubtotal').dataset.value) || 0;
            const zoneSelect = document.getElementById('zoneSelect');
            const deliveryFields = document.getElementById('deliveryFields');
            const pickupNotice = document.getElementById('pickupNotice');
            const deliveryRadios = document.getElementsByName('DeliveryType');
            let discount = 0;

            const fmt = v => v.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';

            function isPickup() {
                return Array.from(deliveryRadios).find(r => r.checked)?.value === '@((int)DeliveryType.GelAl)';
            }

            function refresh() {
                const pickup = isPickup();
                deliveryFields.style.display = pickup ? 'none' : '';
                pickupNotice.style.display = pickup ? '' : 'none';

                const opt = zoneSelect.options[zoneSelect.selectedIndex];
                const fee = !pickup && opt && opt.dataset.fee ? parseFloat(opt.dataset.fee) : 0;
                document.getElementById('sumShipping').textContent = pickup
                    ? '@L["Ücretsiz (Gel Al)"]'
                    : (opt && opt.value ? fmt(fee) : '@L["Bölge seçiniz"]');
                const row = document.getElementById('discountRow');
                row.style.setProperty('display', discount > 0 ? 'flex' : 'none', 'important');
                document.getElementById('sumDiscount').textContent = '−' + fmt(discount);
                document.getElementById('sumTotal').textContent = fmt(Math.max(0, subTotal + fee - discount));
            }

            deliveryRadios.forEach(r => r.addEventListener('change', refresh));
            zoneSelect.addEventListener('change', refresh);

            document.getElementById('promoCheckBtn').addEventListener('click', async function () {
                const code = document.getElementById('PromoCode').value.trim();
                const msg = document.getElementById('promoMsg');
                if (!code) { discount = 0; msg.textContent = ''; refresh(); return; }
                try {
                    const res = await fetch('/siparis/promo-kontrol?kod=' + encodeURIComponent(code));
                    const data = await res.json();
                    discount = data.valid ? data.discount : 0;
                    msg.textContent = data.message;
                    msg.style.color = data.valid ? 'var(--kw-sage)' : 'var(--kw-accent-dark)';
                } catch { discount = 0; msg.textContent = '@L["Kod kontrol edilemedi."]'; }
                refresh();
            });

            refresh();

            // Ürün sayfasında seçilen bölge/tarih/saat varsa (sessionStorage), formu bir kerelik
            // otomatik doldurur — kullanıcı Checkout'a gelince aynı bilgileri tekrar girmesin.
            (function prefillFromProductPage() {
                let zoneId, deliveryDate, slot;
                try {
                    zoneId = sessionStorage.getItem('pdp_zone_id');
                    deliveryDate = sessionStorage.getItem('pdp_delivery_date');
                    slot = sessionStorage.getItem('pdp_time_slot');
                } catch (e) { return; }
                if (!zoneId && !deliveryDate) return;

                if (zoneId === 'pickup') {
                    document.getElementById('dtGelAl').checked = true;
                    document.getElementById('dtGelAl').dispatchEvent(new Event('change'));
                } else if (zoneId) {
                    zoneSelect.value = zoneId;
                }
                const dateInput = document.getElementById('DeliveryDate');
                if (deliveryDate && dateInput && !dateInput.value) dateInput.value = deliveryDate;
                const slotSelect = document.getElementById('DeliveryTimeSlot');
                if (slot && slotSelect) slotSelect.value = slot;

                refresh();
            })();
        })();
    </script>
    <partial name="_ValidationScriptsPartial" />
}
