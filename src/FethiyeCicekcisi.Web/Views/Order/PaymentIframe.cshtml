@model FethiyeCicekcisi.Web.ViewModels.Order.OrderSummaryViewModel
@{
    ViewData["Title"] = "Ödeme";
    Layout = "_Layout";
}

<div class="container py-5 text-center">
    <h2 class="section-title mb-2">Güvenli Ödeme</h2>
    <p class="text-muted mb-5">Sipariş No: <strong>@Model.Order.OrderNumber</strong> | Toplam: <strong>@Model.Order.TotalAmount.ToString("N2") ₺</strong></p>

    @if (!string.IsNullOrEmpty(Model.PayTRIframeToken))
    {
        <div class="d-flex justify-content-center">
            <iframe src="https://www.paytr.com/odeme/guvenli/@Model.PayTRIframeToken"
                    id="paytriframe"
                    frameborder="0"
                    scrolling="no"
                    style="width:100%;max-width:600px;min-height:500px">
            </iframe>
        </div>
        <script>
            window.addEventListener('message', function(e) {
                if (e.data.event === 'iframeHeight') {
                    document.getElementById('paytriframe').style.minHeight = (e.data.value + 30) + 'px';
                }
            }, false);
        </script>
    }
    else
    {
        <div class="alert alert-danger">Ödeme başlatılamadı. Lütfen tekrar deneyin.</div>
        <a asp-controller="Order" asp-action="Checkout" class="btn-kw-outline mt-3">Geri Dön</a>
    }
</div>
