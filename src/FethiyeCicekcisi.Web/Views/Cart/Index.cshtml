@model FethiyeCicekcisi.Web.ViewModels.Cart.CartViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = "Sepetim";
}

@Html.AntiForgeryToken()

<div class="container py-5">
    <h1 class="section-title mb-5">@L["Sepetim"]</h1>

    @if (!Model.Items.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-bag fs-1 text-muted d-block mb-3"></i>
            <h5 class="text-muted fw-normal">@L["Sepetiniz boş."]</h5>
            <a asp-controller="Product" asp-action="Index" class="btn-kw-dark mt-4">@L["Alışverişe Başla"]</a>
        </div>
    }
    else
    {
                <div class="row g-4">
            <!-- Cart Items -->
            <div class="col-lg-8">
                @foreach (var item in Model.Items)
                {
                    <div class="d-flex gap-3 mb-4 pb-4 border-bottom" id="cart-item-@item.Id">
                        <img src="@(item.Product?.MainImageUrl ?? "/images/products/placeholder.jpg")"
                             alt="@item.Product?.GetLocalizedName()"
                             class="cart-item-image"
                             onerror="this.src='/images/products/placeholder.jpg'" />
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="mb-1">
                                        <a asp-controller="Product" asp-action="Detail"
                                           asp-route-slug="@item.Product?.Slug">@item.Product?.GetLocalizedName()</a>
                                    </h6>
                                    @if (!string.IsNullOrEmpty(item.ProductVariant?.Size))
                                    {
                                        <small class="text-muted">
                                            <span>@L["Seçenek"]: @item.ProductVariant.Size</span>
                                        </small>
                                    }
                                </div>
                                <button class="btn btn-link text-muted p-0" onclick="removeCartItem(@item.Id)">
                                    <i class="bi bi-x-lg" style="font-size:.9rem"></i>
                                </button>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <div class="qty-control">
                                    <button class="qty-btn" data-item-id="@item.Id" data-direction="down">−</button>
                                    <span class="qty-value" data-item-id="@item.Id">@item.Quantity</span>
                                    <button class="qty-btn" data-item-id="@item.Id" data-direction="up">+</button>
                                </div>
                                <div class="fw-600">@item.TotalPrice.ToString("N2") ₺</div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Order Summary -->
            <div class="col-lg-4">
                <div class="order-summary-box">
                    <h5 class="mb-4" style="font-family:var(--font-serif)">@L["Sipariş Özeti"]</h5>
                    <div class="d-flex justify-content-between mb-2" style="font-size:.9rem">
                        <span>@L["Ara Toplam"]</span>
                        <span id="cartSubtotal">@Model.SubTotal.ToString("N2") ₺</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3" style="font-size:.9rem">
                        <span>@L["Teslimat"]</span>
                        <span id="cartShipping" class="text-muted" style="font-size:.82rem">@L["Bölgeye göre, ödeme adımında"]</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between mb-4">
                        <span class="fw-600">@L["Toplam"]</span>
                        <span class="fw-600" id="cartTotal" data-subtotal="@Model.SubTotal.ToString(System.Globalization.CultureInfo.InvariantCulture)">@Model.Total.ToString("N2") ₺</span>
                    </div>
                    <a asp-controller="Order" asp-action="Checkout" class="btn-kw-dark d-block text-center w-100">
                        @L["Ödemeye Geç"]
                    </a>
                    <a asp-controller="Product" asp-action="Index" class="d-block text-center mt-3 text-muted" style="font-size:.82rem">
                        @L["Alışverişe Devam Et"]
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Ürün sayfasında bir teslimat bölgesi seçilmişse (sessionStorage), sepette de
        // gerçek teslimat ücretini gösterir — Checkout'a gidince aynı seçim otomatik dolar.
        (function () {
            const zones = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.Zones.Select(z => new { id = z.Id, fee = z.Fee })));
            const shippingEl = document.getElementById('cartShipping');
            const totalEl = document.getElementById('cartTotal');
            if (!shippingEl || !totalEl) return;
            let zoneId;
            try { zoneId = sessionStorage.getItem('pdp_zone_id'); } catch (e) { return; }
            if (!zoneId) return;

            const subTotal = parseFloat(totalEl.dataset.subtotal) || 0;
            const fmt = v => v.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';

            if (zoneId === 'pickup') {
                shippingEl.textContent = '@L["Ücretsiz (Gel Al)"]';
                shippingEl.classList.remove('text-muted');
                totalEl.textContent = fmt(subTotal);
                return;
            }
            const zone = zones.find(z => String(z.id) === zoneId);
            if (!zone) return;
            shippingEl.textContent = fmt(zone.fee);
            shippingEl.classList.remove('text-muted');
            totalEl.textContent = fmt(subTotal + zone.fee);
        })();

        async function removeCartItem(id) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            try {
                const res = await fetch(`/sepet/sil/${id}`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token || '' }
                });
                const data = await res.json();
                if (data.success) {
                    document.getElementById(`cart-item-${id}`)?.remove();
                    updateCartBadge();
                    if (data.cartCount === 0) location.reload();
                }
            } catch(e) {}
        }
    </script>
}
