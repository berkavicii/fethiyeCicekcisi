@model FethiyeCicekcisi.Web.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="container py-5" style="max-width:440px">
    <h1 class="section-title mb-2 text-center">Giriş Yap</h1>
    <p class="text-muted text-center mb-5" style="font-size:.88rem">Hesabınıza giriş yapın</p>

    <form asp-controller="Account" asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />

        <div asp-validation-summary="All" class="alert alert-danger" style="font-size:.85rem"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label" style="font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em"></label>
            <input asp-for="Email" class="form-control form-control-kw" type="email" autocomplete="email" />
        </div>
        <div class="mb-4">
            <div class="d-flex justify-content-between">
                <label asp-for="Password" class="form-label" style="font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em"></label>
                <a asp-controller="Account" asp-action="ForgotPassword" style="font-size:.8rem" tabindex="-1">Şifremi Unuttum</a>
            </div>
            <input asp-for="Password" class="form-control form-control-kw" type="password" autocomplete="current-password" />
        </div>
        <div class="mb-4">
            <div class="form-check">
                <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                <label asp-for="RememberMe" class="form-check-label" style="font-size:.85rem"></label>
            </div>
        </div>

        <button type="submit" class="btn-kw-dark w-100 border-0">Giriş Yap</button>
    </form>

    <p class="text-center mt-4 text-muted" style="font-size:.85rem">
        Hesabınız yok mu?
        <a asp-controller="Account" asp-action="Register">Kayıt Ol</a>
    </p>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
