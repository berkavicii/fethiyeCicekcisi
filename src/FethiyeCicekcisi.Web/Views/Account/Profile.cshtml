@model FethiyeCicekcisi.Web.ViewModels.Account.ProfileViewModel
@{
    ViewData["Title"] = "Hesabım";
}

<div class="container py-5" style="max-width:600px">
    <h1 class="section-title mb-5">Hesabım</h1>

    <form asp-controller="Account" asp-action="Profile" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="font-size:.85rem"></div>

        <div class="card border-0 bg-light-kw mb-4">
            <div class="card-body">
                <h6 class="fw-600 mb-3" style="font-size:.82rem;text-transform:uppercase;letter-spacing:.07em">Kişisel Bilgiler</h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label" style="font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em"></label>
                        <input asp-for="FirstName" class="form-control form-control-kw" />
                        <span asp-validation-for="FirstName" class="text-danger" style="font-size:.78rem"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label" style="font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em"></label>
                        <input asp-for="LastName" class="form-control form-control-kw" />
                        <span asp-validation-for="LastName" class="text-danger" style="font-size:.78rem"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Email" class="form-label" style="font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em"></label>
                        <input asp-for="Email" class="form-control form-control-kw" readonly style="background:#f5f0e8" />
                    </div>
                    <div class="col-12">
                        <label asp-for="PhoneNumber" class="form-label" style="font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em"></label>
                        <input asp-for="PhoneNumber" class="form-control form-control-kw" type="tel" />
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 bg-light-kw mb-4">
            <div class="card-body">
                <h6 class="fw-600 mb-3" style="font-size:.82rem;text-transform:uppercase;letter-spacing:.07em">Şifre Değiştir <small class="text-muted fw-400">(Opsiyonel)</small></h6>
                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label" style="font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em"></label>
                    <input asp-for="CurrentPassword" class="form-control form-control-kw" type="password" autocomplete="current-password" />
                </div>
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label" style="font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em"></label>
                    <input asp-for="NewPassword" class="form-control form-control-kw" type="password" autocomplete="new-password" />
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmNewPassword" class="form-label" style="font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em"></label>
                    <input asp-for="ConfirmNewPassword" class="form-control form-control-kw" type="password" autocomplete="new-password" />
                </div>
            </div>
        </div>

        <div class="d-flex gap-3">
            <button type="submit" class="btn-kw-dark border-0">Kaydet</button>
            <a asp-controller="Order" asp-action="MyOrders" class="btn-kw-outline">Siparişlerim</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
