@model FethiyeCicekcisi.Web.ViewModels.Account.RegisterViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="container py-5" style="max-width:440px">
    <h1 class="section-title mb-2 text-center">@L["Kayıt Ol"]</h1>
    <p class="text-muted text-center mb-5" style="font-size:.88rem">@L["Yeni hesap oluşturun"]</p>

    <form asp-controller="Account" asp-action="Register" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="font-size:.85rem"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="FirstName" class="form-label" style="font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em"></label>
                <input asp-for="FirstName" class="form-control form-control-kw" autocomplete="given-name" />
                <span asp-validation-for="FirstName" class="text-danger" style="font-size:.78rem"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="LastName" class="form-label" style="font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em"></label>
                <input asp-for="LastName" class="form-control form-control-kw" autocomplete="family-name" />
                <span asp-validation-for="LastName" class="text-danger" style="font-size:.78rem"></span>
            </div>
            <div class="col-12">
                <label asp-for="Email" class="form-label" style="font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em"></label>
                <input asp-for="Email" class="form-control form-control-kw" type="email" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger" style="font-size:.78rem"></span>
            </div>
            <div class="col-12">
                <label asp-for="Password" class="form-label" style="font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em"></label>
                <input asp-for="Password" class="form-control form-control-kw" type="password" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger" style="font-size:.78rem"></span>
            </div>
            <div class="col-12">
                <label asp-for="ConfirmPassword" class="form-label" style="font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em"></label>
                <input asp-for="ConfirmPassword" class="form-control form-control-kw" type="password" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:.78rem"></span>
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="AgreeToMembershipTerms" class="form-check-input" type="checkbox" />
                    @{
                        var membershipUrl = Url.Action("MembershipAgreement", "Legal");
                        var kvkkUrl = Url.Action("KvkkNotice", "Legal");
                        var membershipLink = "<a href=\"" + membershipUrl + "\" target=\"_blank\">" + L["Üyelik Sözleşmesi'ni"] + "</a>";
                        var kvkkLink = "<a href=\"" + kvkkUrl + "\" target=\"_blank\">" + L["KVKK Aydınlatma Metni'ni"] + "</a>";
                        var membershipAgreementHtml = string.Format(L["{0} ve {1} okudum, kabul ediyorum."].Value, membershipLink, kvkkLink);
                    }
                    <label class="form-check-label" for="AgreeToMembershipTerms" style="font-size:.83rem">
                        @Html.Raw(membershipAgreementHtml)
                    </label>
                    <span asp-validation-for="AgreeToMembershipTerms" class="text-danger d-block" style="font-size:.78rem"></span>
                </div>
            </div>
        </div>

        <button type="submit" class="btn-kw-dark w-100 border-0 mt-4">@L["Hesap Oluştur"]</button>
    </form>

    @if (ViewBag.GoogleEnabled == true)
    {
        <div class="d-flex align-items-center gap-3 my-4">
            <hr class="flex-grow-1" /><span class="text-muted" style="font-size:.8rem">@L["veya"]</span><hr class="flex-grow-1" />
        </div>
        <a asp-controller="Account" asp-action="GoogleLogin"
           class="btn btn-outline-dark w-100 d-flex align-items-center justify-content-center gap-2" style="font-size:.9rem">
            <svg width="18" height="18" viewBox="0 0 18 18"><path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.9c1.7-1.56 2.7-3.86 2.7-6.62z"/><path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.9-2.26c-.8.54-1.84.86-3.06.86-2.35 0-4.34-1.59-5.05-3.72H.98v2.33A9 9 0 0 0 9 18z"/><path fill="#FBBC05" d="M3.95 10.7A5.4 5.4 0 0 1 3.67 9c0-.59.1-1.17.28-1.7V4.97H.98A9 9 0 0 0 0 9c0 1.45.35 2.83.98 4.03l2.97-2.33z"/><path fill="#EA4335" d="M9 3.58c1.32 0 2.51.46 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0A9 9 0 0 0 .98 4.97l2.97 2.33C4.66 5.17 6.65 3.58 9 3.58z"/></svg>
            @L["Google ile Devam Et"]
        </a>
    }

    <p class="text-center mt-4 text-muted" style="font-size:.85rem">
        @L["Zaten hesabınız var mı?"]
        <a asp-controller="Account" asp-action="Login">@L["Giriş Yap"]</a>
    </p>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
