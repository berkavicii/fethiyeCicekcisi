@model FethiyeCicekcisi.Web.ViewModels.Product.ProductListViewModel
@{
    ViewData["Title"] = Model.OccasionName ?? Model.CategoryName ?? "Çiçekler";
}

<div class="container py-5">
    <div class="row mb-5 align-items-end reveal">
        <div class="col">
            <p class="section-tag mb-2">@(Model.OccasionName != null ? "Özel Gün" : "Koleksiyon")</p>
            <h1 class="section-title mb-2">@(Model.OccasionName ?? Model.CategoryName ?? "Tüm Çiçekler")</h1>
            <p class="text-muted mb-0" style="font-size:.85rem;font-style:italic;font-family:var(--font-serif)">@Model.TotalCount tasarım</p>
        </div>
    </div>

    <div class="row g-4 g-lg-5">
        <!-- Sidebar Filters -->
        <div class="col-md-3">
            <form method="get" asp-controller="Product" asp-action="Index">
                @* Arama/sıralama form submit'i seçili kategori, özel gün ve seçeneği kaybetmesin *@
                @if (Model.SelectedCategoryId.HasValue)
                {
                    <input type="hidden" name="kategori" value="@Model.SelectedCategoryId" />
                }
                @if (Model.SelectedOccasionId.HasValue)
                {
                    <input type="hidden" name="ozelgun" value="@Model.SelectedOccasionId" />
                }
                @if (!string.IsNullOrEmpty(Model.SelectedSize))
                {
                    <input type="hidden" name="secenek" value="@Model.SelectedSize" />
                }
                <!-- Search -->
                <div class="filter-block">
                    <label class="section-tag">Ara</label>
                    <input type="text" name="ara" value="@Model.SearchTerm" class="form-control form-control-kw mt-2" placeholder="Çiçek ara...">
                </div>

                <!-- Categories -->
                <div class="filter-block">
                    <label class="section-tag">Kategori</label>
                    <div class="d-flex flex-column gap-2 mt-3">
                        <a asp-controller="Product" asp-action="Index"
                           class="filter-link @(Model.SelectedCategoryId == null && Model.SelectedOccasionId == null ? "active" : "")">
                            Tümü
                        </a>
                        @foreach (var cat in Model.Categories)
                        {
                            <a asp-controller="Product" asp-action="Index" asp-route-kategori="@cat.Id"
                               asp-route-secenek="@Model.SelectedSize"
                               class="filter-link @(Model.SelectedCategoryId == cat.Id ? "active" : "")">
                                @cat.Name
                            </a>
                        }
                    </div>
                </div>

                <!-- Occasions -->
                @if (Model.Occasions.Any())
                {
                    <div class="filter-block">
                        <label class="section-tag">Özel Gün</label>
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            @foreach (var occasion in Model.Occasions)
                            {
                                var isSelected = Model.SelectedOccasionId == occasion.Id;
                                <a asp-controller="Product" asp-action="Index"
                                   asp-route-kategori="@Model.SelectedCategoryId"
                                   asp-route-ara="@Model.SearchTerm"
                                   asp-route-sirala="@Model.SortBy"
                                   asp-route-ozelgun="@(isSelected ? null : (int?)occasion.Id)"
                                   class="occasion-chip @(isSelected ? "active" : "")">
                                    @occasion.Name
                                </a>
                            }
                        </div>
                    </div>
                }

                <!-- Options (boy/adet) -->
                @if (Model.AvailableSizes.Any())
                {
                    <div class="filter-block">
                        <label class="section-tag">Seçenek</label>
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            @foreach (var size in Model.AvailableSizes)
                            {
                                var isSelected = string.Equals(Model.SelectedSize, size, StringComparison.OrdinalIgnoreCase);
                                <a asp-controller="Product" asp-action="Index"
                                   asp-route-kategori="@Model.SelectedCategoryId"
                                   asp-route-ozelgun="@Model.SelectedOccasionId"
                                   asp-route-ara="@Model.SearchTerm"
                                   asp-route-sirala="@Model.SortBy"
                                   asp-route-secenek="@(isSelected ? null : size)"
                                   class="variant-btn @(isSelected ? "active" : "")"
                                   style="padding:.4rem .85rem;font-size:.74rem;text-decoration:none">
                                    @size
                                </a>
                            }
                        </div>
                    </div>
                }

                <!-- Sort -->
                <div class="filter-block">
                    <label class="section-tag">Sırala</label>
                    <select name="sirala" class="form-select form-control-kw mt-2" onchange="this.form.submit()">
                        <option value="">Varsayılan</option>
                        <option value="newest" selected="@(Model.SortBy == "newest")">En Yeni</option>
                        <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Fiyat (Düşük-Yüksek)</option>
                        <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Fiyat (Yüksek-Düşük)</option>
                    </select>
                </div>
                @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.SelectedCategoryId.HasValue || Model.SelectedOccasionId.HasValue || !string.IsNullOrEmpty(Model.SelectedSize))
                {
                    <a asp-controller="Product" asp-action="Index" class="link-quiet" style="font-size:.68rem">Filtreleri Temizle ×</a>
                }
            </form>
        </div>

        <!-- Product Grid -->
        <div class="col-md-9">
            @if (!Model.Products.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-flower1 fs-1 text-muted d-block mb-3"></i>
                    <p class="text-muted">Aradığınız kriterlere uygun çiçek bulunamadı.</p>
                    <a asp-controller="Product" asp-action="Index" class="btn-kw-outline mt-2">Tüm Çiçeklere Git</a>
                </div>
            }
            else
            {
                <div class="row row-cols-2 row-cols-lg-3 g-3 g-lg-4">
                    @foreach (var product in Model.Products)
                    {
                        <div class="col reveal">
                            <a asp-controller="Product" asp-action="Detail" asp-route-slug="@product.Slug" class="d-block">
                                <div class="product-card">
                                    <div class="product-card-image">
                                        @if (!string.IsNullOrEmpty(product.MainImageUrl))
                                        {
                                            <img src="@product.MainImageUrl" alt="@product.Name" loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center justify-content-center h-100">
                                                <i class="bi bi-flower1" style="font-size:2.5rem;color:var(--kw-gray-2)"></i>
                                            </div>
                                        }
                                        @if (product.IsOnSale)
                                        {
                                            <span class="product-badge product-badge-sale">İndirim</span>
                                        }
                                        else if (product.IsSameDayDelivery)
                                        {
                                            <span class="product-badge">Aynı Gün</span>
                                        }
                                    </div>
                                    <div class="product-card-body">
                                        <div class="product-category">@product.Category?.Name</div>
                                        <div class="product-name" title="@product.Name">@product.Name</div>
                                        <div class="mt-1">
                                            @if (product.IsOnSale)
                                            {
                                                <span class="product-price-original">@product.Price.ToString("N2") ₺</span>
                                                <span class="product-price product-price-sale">@product.CurrentPrice.ToString("N2") ₺</span>
                                            }
                                            else
                                            {
                                                <span class="product-price">@product.Price.ToString("N2") ₺</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-5 d-flex justify-content-center">
                        <ul class="pagination">
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-controller="Product" asp-action="Index"
                                       asp-route-page="@i"
                                       asp-route-kategori="@Model.SelectedCategoryId"
                                       asp-route-ozelgun="@Model.SelectedOccasionId"
                                       asp-route-ara="@Model.SearchTerm"
                                       asp-route-sirala="@Model.SortBy"
                                       asp-route-secenek="@Model.SelectedSize">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>
