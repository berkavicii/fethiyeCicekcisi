                        @activeLanguage.Flag
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-minimal">
                        @foreach (var lang in supportedLanguages)
                        {
                            <li>
                                <button type="button" onclick="kwSetSiteLanguage('@lang.Code')" class="dropdown-item d-flex align-items-center gap-2 @(lang.Code == activeLanguage.Code ? "active" : "")">
                                    <span style="font-size:1.05rem">@lang.Flag</span> @lang.Label
                                </button>
                            </li>
                        }
                    </ul>
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown">
                        <a href="#" class="nav-icon-btn" data-bs-toggle="dropdown">
                            <i class="bi bi-person fs-5"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-minimal">
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">@L["Profilim"]</a></li>
                            <li><a class="dropdown-item" asp-controller="Order" asp-action="MyOrders">@L["Siparişlerim"]</a></li>
                            @if (User.IsInRole("Admin"))
                            {
