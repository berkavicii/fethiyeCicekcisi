@using System.Text.Json
@using Microsoft.Extensions.Localization
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject IStringLocalizer<SharedResource> L
@{
    var supportedLanguages = new[]
    {
        (Code: "tr", Flag: "🇹🇷", Label: "Türkçe"),
        (Code: "en", Flag: "🇬🇧", Label: "English"),
        (Code: "ru", Flag: "🇷🇺", Label: "Русский"),
        (Code: "de", Flag: "🇩🇪", Label: "Deutsch")
    };
    // Aktif dil, RequestLocalization'ın okuduğu "site_lang" çerezinden gelir (Program.cs).
    // Google Translate widget'ı kaldırıldı — performans sorunlarına yol açıyordu; bunun yerine
    // ürün adı/açıklaması admin panelinde elle (veya Google Translate'e tek tıkla açılıp oradan
    // kopyalanarak) her dilde giriliyor (bkz. ProductAdminController, ProductTranslation).
    var activeCode = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var activeLanguage = supportedLanguages.FirstOrDefault(l => l.Code == activeCode);
    if (activeLanguage.Code is null) activeLanguage = supportedLanguages[0];

    // Tüm SEO meta üretimi tek yerden: her view ViewData["Title"/"Description"/"CanonicalUrl"/
    // "OgImage"/"Robots"] set ederek override edebilir, hiçbiri set etmezse makul varsayılanlara düşer.
    var siteUrl = (Configuration["SiteSettings:SiteUrl"] ?? "https://www.fethiyecicekcisi.com").TrimEnd('/');
    var pageTitle = ViewData["Title"] as string;
    var fullTitle = string.IsNullOrWhiteSpace(pageTitle) ? "Yonca Çiçekçilik" : $"{pageTitle} — Yonca Çiçekçilik";
    var metaDescription = ViewData["Description"] as string
        ?? "Yonca Çiçekçilik — taze çiçek, el bağlaması buket, orkide ve aranjman. Fethiye içi aynı gün teslimat.";
    // Sıralama/filtre/sayfalama query string'leri (?sirala=, ?sayfa=, ?ara= vb.) aynı içeriği farklı
    // URL'lerde tekrar ettirip duplicate content'e yol açabilir — canonical varsayılan olarak
    // query string'siz temiz path'e işaret eder; bir view farklısını istiyorsa CanonicalUrl override eder.
    var canonicalUrl = ViewData["CanonicalUrl"] as string ?? $"{siteUrl}{Context.Request.Path}";
    var ogImage = ViewData["OgImage"] as string ?? $"{siteUrl}/images/logo.png";
    var robots = ViewData["Robots"] as string ?? "index, follow";

    // Dictionary + JsonSerializer ile üretiliyor: @(...) ile doğrudan string interpolation
    // Razor'ın HTML-encode'undan geçer (ör. "+" → "&#x2B;") ve script içindeki JSON'u bozar.
    var orgJsonLd = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "FloristShop",
        ["name"] = "Yonca Çiçekçilik",
        ["url"] = siteUrl,
        ["image"] = $"{siteUrl}/images/logo.png",
        ["telephone"] = Configuration["SiteSettings:ContactPhone"],
        ["email"] = Configuration["SiteSettings:ContactEmail"],
        ["address"] = new Dictionary<string, object?>
        {
            ["@type"] = "PostalAddress",
            ["streetAddress"] = "Tuzla, İnönü Blv. 125/c",
            ["addressLocality"] = "Fethiye",
            ["addressRegion"] = "Muğla",
            ["postalCode"] = "48300",
            ["addressCountry"] = "TR"
        },
        ["sameAs"] = new[] { Configuration["SiteSettings:InstagramUrl"] }
    };
    var orgJsonLdJson = JsonSerializer.Serialize(orgJsonLd);
}
<!DOCTYPE html>
<html lang="@activeLanguage.Code">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@fullTitle</title>
    <meta name="description" content="@metaDescription" />
    <meta name="robots" content="@robots" />
    <link rel="canonical" href="@canonicalUrl" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yonca Çiçekçilik" />
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:locale" content="tr_TR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@fullTitle" />
    <meta name="twitter:description" content="@metaDescription" />
    <meta name="twitter:image" content="@ogImage" />

    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,350;0,9..144,400;0,9..144,450;0,9..144,500;1,9..144,350;1,9..144,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Organization / LocalBusiness structured data — her sayfada sabit, arama sonuçlarında
         işletme kimliğinin (adres, telefon, sosyal medya) tanınması için. -->
    <script type="application/ld+json">@Html.Raw(orgJsonLdJson)</script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

