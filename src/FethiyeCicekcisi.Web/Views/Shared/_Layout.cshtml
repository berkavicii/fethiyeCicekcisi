<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Yonca Çiçekçilik</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Yonca Çiçekçilik — taze çiçek, el bağlaması buket, orkide ve aranjman. Fethiye içi aynı gün teslimat.")" />

    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,350;0,9..144,400;0,9..144,450;0,9..144,500;1,9..144,350;1,9..144,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- Announcement Bar -->
    <div class="announcement-bar text-center py-2 px-3">
        <small><i class="bi bi-flower1 me-1"></i>Fethiye içi <strong>aynı gün teslimat</strong> &nbsp;|&nbsp; Saat <strong>13:00–17:00</strong> ve <strong>17:00–21:00</strong> teslimat dilimleri</small>
    </div>

    <!-- Navbar -->
    @{
        var isHomePage = ViewContext.RouteData.Values["controller"]?.ToString() == "Home"
            && ViewContext.RouteData.Values["action"]?.ToString() == "Index";
    }
    <nav class="navbar navbar-expand-lg sticky-top @(isHomePage ? "navbar-home-transparent" : "")" id="mainNav">
        <div class="container d-flex align-items-center justify-content-between">
            <a class="navbar-brand me-0" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="/images/logo.png" alt="Yonca Çiçekçilik" class="brand-logo" />
            </a>

            <ul class="navbar-nav d-none d-lg-flex flex-row gap-1 mx-auto mb-0">
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Çiçekler</a>
                    <ul class="dropdown-menu dropdown-menu-minimal">
                        <li><a class="dropdown-item" asp-controller="Product" asp-action="Category" asp-route-slug="buketler">Buketler</a></li>
                        <li><a class="dropdown-item" asp-controller="Product" asp-action="Category" asp-route-slug="orkideler">Orkideler</a></li>
                        <li><a class="dropdown-item" asp-controller="Product" asp-action="Category" asp-route-slug="aranjmanlar">Aranjmanlar</a></li>
                        <li><a class="dropdown-item" asp-controller="Product" asp-action="Category" asp-route-slug="saksi-cicekleri">Saksı Çiçekleri</a></li>
                        <li><a class="dropdown-item" asp-controller="Product" asp-action="Category" asp-route-slug="teraryumlar">Teraryumlar</a></li>
                        <li><a class="dropdown-item" asp-controller="Product" asp-action="Category" asp-route-slug="celenkler">Çelenkler</a></li>
                        <li><a class="dropdown-item" asp-controller="Product" asp-action="Category" asp-route-slug="yapay-cicekler">Yapay Çiçekler</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" asp-controller="Product" asp-action="Index">Tüm Çiçekler</a></li>
                    </ul>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Özel Günler</a>
                    <ul class="dropdown-menu dropdown-menu-minimal">
                        <li><a class="dropdown-item" asp-controller="Product" asp-action="Occasion" asp-route-slug="sevgililer-gunu">Sevgililer Günü</a></li>
                        <li><a class="dropdown-item" asp-controller="Product" asp-action="Occasion" asp-route-slug="anneler-gunu">Anneler Günü</a></li>
                        <li><a class="dropdown-item" asp-controller="Product" asp-action="Occasion" asp-route-slug="dogum-gunu">Doğum Günü</a></li>
                        <li><a class="dropdown-item" asp-controller="Product" asp-action="Occasion" asp-route-slug="gecmis-olsun">Geçmiş Olsun</a></li>
                        <li><a class="dropdown-item" asp-controller="Product" asp-action="Occasion" asp-route-slug="yeni-is">Yeni İş</a></li>
                        <li><a class="dropdown-item" asp-controller="Product" asp-action="Occasion" asp-route-slug="kadinlar-gunu">Kadınlar Günü</a></li>
                        <li><a class="dropdown-item" asp-controller="Product" asp-action="Occasion" asp-route-slug="ogretmenler-gunu">Öğretmenler Günü</a></li>
                    </ul>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="About">Hakkımızda</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Contact">İletişim</a>
                </li>
            </ul>

            <div class="d-none d-lg-flex align-items-center gap-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown">
                        <a href="#" class="nav-icon-btn" data-bs-toggle="dropdown">
                            <i class="bi bi-person fs-5"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-minimal">
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">Profilim</a></li>
                            <li><a class="dropdown-item" asp-controller="Order" asp-action="MyOrders">Siparişlerim</a></li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" href="/admin">Admin Panel</a></li>
                            }
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item">Çıkış Yap</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="nav-icon-btn" title="Giriş Yap">
                        <i class="bi bi-person fs-5"></i>
                    </a>
                }

                <a asp-controller="Cart" asp-action="Index" class="nav-icon-btn position-relative" title="Sepet">
                    <i class="bi bi-bag fs-5"></i>
                    <span class="cart-badge" id="cartBadgeDesktop">0</span>
                </a>
            </div>

            <div class="d-flex align-items-center gap-2 d-lg-none">
                <a asp-controller="Cart" asp-action="Index" class="nav-icon-btn position-relative">
                    <i class="bi bi-bag fs-5"></i>
                    <span class="cart-badge" id="cartBadgeMobile">0</span>
                </a>
                <button class="navbar-toggler border-0 p-1" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu" aria-controls="mobileMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>
        </div>
    </nav>

    <!-- Mobile off-canvas menu -->
    <div class="offcanvas offcanvas-end offcanvas-kw" tabindex="-1" id="mobileMenu" aria-labelledby="mobileMenuLabel">
        <div class="offcanvas-header">
            <img src="/images/logo.png" alt="Yonca Çiçekçilik" class="brand-logo" style="height:40px" id="mobileMenuLabel" />
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Kapat"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column">
            <a class="nav-link" data-bs-dismiss="offcanvas" asp-area="" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
            <a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Product" asp-action="Category" asp-route-slug="buketler">Buketler</a>
            <a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Product" asp-action="Category" asp-route-slug="orkideler">Orkideler</a>
            <a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Product" asp-action="Category" asp-route-slug="aranjmanlar">Aranjmanlar</a>
            <a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Product" asp-action="Category" asp-route-slug="saksi-cicekleri">Saksı Çiçekleri</a>
            <a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Product" asp-action="Category" asp-route-slug="teraryumlar">Teraryumlar</a>
            <a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Product" asp-action="Category" asp-route-slug="celenkler">Çelenkler</a>
            <a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Product" asp-action="Index">Tüm Çiçekler</a>
            <a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Home" asp-action="About">Hakkımızda</a>
            <a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Home" asp-action="Contact">İletişim</a>

            <div class="mt-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>Profilim</a>
                    <a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Order" asp-action="MyOrders"><i class="bi bi-bag-check me-2"></i>Siparişlerim</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="nav-link" data-bs-dismiss="offcanvas" href="/admin"><i class="bi bi-speedometer2 me-2"></i>Admin Panel</a>
                    }
                    <form asp-controller="Account" asp-action="Logout" method="post" class="mt-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-kw-outline w-100">Çıkış Yap</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn-kw-dark w-100 mt-2" data-bs-dismiss="offcanvas">Giriş Yap</a>
                }
            </div>
        </div>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer"></div>

    <main>
        @if (TempData["Success"] is string successMsg)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@successMsg
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] is string errorMsg)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@errorMsg
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <section class="trust-badges py-4 bg-white">
        <div class="container">
            <div class="row g-4 g-lg-3">
                <div class="col-6 col-lg-3">
                    <div class="trust-badge">
                        <div class="trust-badge-icon"><i class="bi bi-lightning-charge"></i></div>
                        <div>
                            <div class="trust-badge-title">Aynı Gün Teslimat</div>
                            <div class="trust-badge-sub">Fethiye içi</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="trust-badge">
                        <div class="trust-badge-icon"><i class="bi bi-flower2"></i></div>
                        <div>
                            <div class="trust-badge-title">Taze Çiçek Garantisi</div>
                            <div class="trust-badge-sub">Mevsiminde, günlük</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="trust-badge">
                        <div class="trust-badge-icon"><i class="bi bi-shield-check"></i></div>
                        <div>
                            <div class="trust-badge-title">Güvenli Ödeme</div>
                            <div class="trust-badge-sub">PayTR ile %100</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="trust-badge">
                        <div class="trust-badge-icon"><i class="bi bi-envelope-heart"></i></div>
                        <div>
                            <div class="trust-badge-title">Not Kartı Hediye</div>
                            <div class="trust-badge-sub">Mesajınız bizden</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <footer class="site-footer py-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <img src="/images/logo.png" alt="Yonca Çiçekçilik" class="brand-logo mb-3" style="filter:brightness(0) invert(1)" />
                    <p class="footer-statement">"Her buket, bir duyguyu yerine ulaştırır."</p>
                    <div class="social-links mt-3 d-flex gap-2">
                        <a href="https://instagram.com/yoncacicekcilik" target="_blank" rel="noopener noreferrer" class="social-link">
                            <i class="bi bi-instagram"></i>
                        </a>
                    </div>
                </div>
                <div class="col-md-2">
                    <h6 class="footer-heading">Çiçekler</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Product" asp-action="Category" asp-route-slug="buketler">Buketler</a></li>
                        <li><a asp-controller="Product" asp-action="Category" asp-route-slug="orkideler">Orkideler</a></li>
                        <li><a asp-controller="Product" asp-action="Category" asp-route-slug="aranjmanlar">Aranjmanlar</a></li>
                        <li><a asp-controller="Product" asp-action="Category" asp-route-slug="celenkler">Çelenkler</a></li>
                        <li><a asp-controller="Product" asp-action="Index">Tüm Çiçekler</a></li>
                    </ul>
                </div>
                <div class="col-md-2">
                    <h6 class="footer-heading">Hesap</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Account" asp-action="Login">Giriş Yap</a></li>
                        <li><a asp-controller="Account" asp-action="Register">Kayıt Ol</a></li>
                        <li><a asp-controller="Order" asp-action="MyOrders">Siparişlerim</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="footer-heading">Yardım</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Contact">İletişim</a></li>
                        <li><a asp-controller="Home" asp-action="About">Hakkımızda</a></li>
                    </ul>
                    <p class="text-muted small mt-3"><i class="bi bi-envelope me-1"></i> info@yoncacicekcilik.com</p>
                    <p class="text-muted small"><i class="bi bi-geo-alt me-1"></i> Fethiye / Muğla</p>
                </div>
            </div>
            <hr class="my-4" />
            <div class="row align-items-center">
                <div class="col text-muted small">
                    &copy; @DateTime.Now.Year Yonca Çiçekçilik. Tüm hakları saklıdır.
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
