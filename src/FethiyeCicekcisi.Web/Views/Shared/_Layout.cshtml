                                <li><a class="dropdown-item" href="/admin">@L["Admin Panel"]</a></li>
                            }
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item">@L["Çıkış Yap"]</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="nav-icon-btn" title="@L["Giriş Yap"]">
                        <i class="bi bi-person fs-5"></i>
                    </a>
                }

                <a asp-controller="Cart" asp-action="Index" class="nav-icon-btn position-relative" title="@L["Sepet"]">
                    <i class="bi bi-bag fs-5"></i>
                    <span class="cart-badge" id="cartBadgeDesktop">0</span>
                </a>
            </div>

            <div class="d-flex align-items-center gap-2 d-lg-none">
                <div class="dropdown">
                    <a href="#" class="nav-icon-btn" data-bs-toggle="dropdown" style="font-size:1.1rem">
                        @activeLanguage.Flag
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-minimal">
                        @foreach (var lang in supportedLanguages)
                        {
                            <li>
                                <button type="button" onclick="kwSetSiteLanguage('@lang.Code')" class="dropdown-item d-flex align-items-center gap-2 @(lang.Code == activeLanguage.Code ? "active" : "")">
                                    <span style="font-size:1.05rem">@lang.Flag</span> @lang.Label
                                </button>
                            </li>
                        }
                    </ul>
                </div>
                <a asp-controller="Cart" asp-action="Index" class="nav-icon-btn position-relative">
                    <i class="bi bi-bag fs-5"></i>
                    <span class="cart-badge" id="cartBadgeMobile">0</span>
                </a>
                <button class="navbar-toggler border-0 p-1" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu" aria-controls="mobileMenu">
                    <span class="navbar-toggler-icon"></span>
