            </div>
        </div>
    </nav>

    <!-- Mobile off-canvas menu -->
    <div class="offcanvas offcanvas-end offcanvas-kw" tabindex="-1" id="mobileMenu" aria-labelledby="mobileMenuLabel">
        <div class="offcanvas-header">
            <img src="/images/logo.png" alt="Yonca Çiçekçilik" class="brand-logo" style="height:40px" id="mobileMenuLabel" />
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Kapat"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column">
            <a class="nav-link" data-bs-dismiss="offcanvas" asp-area="" asp-controller="Home" asp-action="Index">@L["Ana Sayfa"]</a>
            <a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Product" asp-action="Category" asp-route-slug="buketler">@L["Buketler"]</a>
            <a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Product" asp-action="Category" asp-route-slug="orkideler">Orkideler</a>
            <a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Product" asp-action="Category" asp-route-slug="aranjmanlar">Aranjmanlar</a>
            <a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Product" asp-action="Category" asp-route-slug="saksi-cicekleri">Saksı Çiçekleri</a>
            <a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Product" asp-action="Category" asp-route-slug="teraryumlar">Teraryumlar</a>
            <a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Product" asp-action="Category" asp-route-slug="celenkler">Çelenkler</a>
            <a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Product" asp-action="Index">@L["Tüm Çiçekler"]</a>
            <a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Home" asp-action="About">@L["Hakkımızda"]</a>
            <a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Home" asp-action="Contact">@L["İletişim"]</a>

            <div class="mt-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>@L["Profilim"]</a>
                    <a class="nav-link" data-bs-dismiss="offcanvas" asp-controller="Order" asp-action="MyOrders"><i class="bi bi-bag-check me-2"></i>@L["Siparişlerim"]</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="nav-link" data-bs-dismiss="offcanvas" href="/admin"><i class="bi bi-speedometer2 me-2"></i>@L["Admin Panel"]</a>
                    }
                    <form asp-controller="Account" asp-action="Logout" method="post" class="mt-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-kw-outline w-100">@L["Çıkış Yap"]</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn-kw-dark w-100 mt-2" data-bs-dismiss="offcanvas">@L["Giriş Yap"]</a>
                }
            </div>
        </div>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer"></div>

    <main>
        @if (TempData["Success"] is string successMsg)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@successMsg
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] is string errorMsg)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@errorMsg
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @RenderBody()
    </main>

