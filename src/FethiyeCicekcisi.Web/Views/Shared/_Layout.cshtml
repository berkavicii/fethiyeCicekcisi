                        <li><a class="dropdown-item" asp-controller="Product" asp-action="Occasion" asp-route-slug="ogretmenler-gunu">Öğretmenler Günü</a></li>
                    </ul>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="About">@L["Hakkımızda"]</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Contact">@L["İletişim"]</a>
                </li>
