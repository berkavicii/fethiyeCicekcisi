@model FethiyeCicekcisi.Web.ViewModels.Admin.AdminStatsViewModel
@{
    ViewData["Title"] = "Satış İstatistikleri";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<!-- Dönem filtresi -->
<div class="d-flex justify-content-end mb-4">
    <div class="btn-group btn-group-sm" role="group" aria-label="Dönem">
        @foreach (var (value, label) in new[] { ((string?)null, "Tümü"), ("30", "Son 30 Gün"), ("90", "Son 90 Gün"), ("365", "Son 1 Yıl") })
        {
            <a href="/admin/istatistikler@(value is null ? "" : $"?donem={value}")"
               class="btn @(Model.Period == value ? "btn-dark" : "btn-outline-dark")">@label</a>
        }
    </div>
</div>

<!-- Özet kartları -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted mb-1" style="font-size:.75rem;text-transform:uppercase;letter-spacing:.08em">Satılan Adet</div>
            <div class="h3 fw-600 mb-0">@Model.TotalUnitsSold</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted mb-1" style="font-size:.75rem;text-transform:uppercase;letter-spacing:.08em">Ciro</div>
            <div class="h3 fw-600 mb-0">@Model.TotalRevenue.ToString("N2") ₺</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted mb-1" style="font-size:.75rem;text-transform:uppercase;letter-spacing:.08em">İade Adedi</div>
            <div class="h3 fw-600 mb-0">@Model.TotalUnitsRefunded</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted mb-1" style="font-size:.75rem;text-transform:uppercase;letter-spacing:.08em">İade Oranı</div>
            <div class="h3 fw-600 mb-0">@Model.OverallRefundRate.ToString("P0")</div>
        </div>
    </div>
</div>

<!-- Ürün bazında satışlar -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom py-3">
        <h6 class="mb-0 fw-600">En Çok Satan Ürünler</h6>
    </div>
    <div class="card-body p-0">
        @if (!Model.Stats.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-graph-up fs-1 d-block mb-3"></i>
                Bu dönemde henüz satış verisi yok.
            </div>
        }
        else
        {
            <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle" style="font-size:.85rem">
                <thead>
                    <tr class="text-muted" style="font-size:.75rem;text-transform:uppercase;letter-spacing:.06em">
                        <th class="ps-3 py-2" style="width:44px">#</th>
                        <th class="py-2">Ürün</th>
                        <th class="py-2">Kategori</th>
                        <th class="py-2 text-end">Satılan Adet</th>
                        <th class="py-2 text-end">Ciro</th>
                        <th class="py-2 text-end">İade Adedi</th>
                        <th class="py-2 text-end pe-3">İade Oranı</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var rank = 0; }
                    @foreach (var s in Model.Stats)
                    {
                        rank++;
                        <tr>
                            <td class="ps-3 py-2 text-muted">@rank</td>
                            <td class="py-2">
                                <div class="d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrEmpty(s.ImageUrl))
                                    {
                                        <img src="@s.ImageUrl" alt="@s.ProductName"
                                             style="width:38px;height:38px;object-fit:cover;border-radius:4px" />
                                    }
                                    <div>
                                        @if (s.ProductDeleted)
                                        {
                                            <span class="fw-500">@s.ProductName</span>
                                            <span class="badge bg-secondary ms-1" style="font-size:.65rem">Silinmiş</span>
                                        }
                                        else
                                        {
                                            <a href="/admin/urunler/duzenle/@s.ProductId" class="fw-500 text-decoration-none">@s.ProductName</a>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="py-2 text-muted">@(s.CategoryName ?? "—")</td>
                            <td class="py-2 text-end fw-600">@s.UnitsSold</td>
                            <td class="py-2 text-end">@s.Revenue.ToString("N2") ₺</td>
                            <td class="py-2 text-end @(s.UnitsRefunded > 0 ? "text-danger fw-600" : "text-muted")">@s.UnitsRefunded</td>
                            <td class="py-2 text-end pe-3 @(s.RefundRate >= 0.25 ? "text-danger fw-600" : "text-muted")">
                                @(s.UnitsSold + s.UnitsRefunded == 0 ? "—" : s.RefundRate.ToString("P0"))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>
</div>

<p class="text-muted mt-3 mb-0" style="font-size:.78rem">
    Satış: ödemesi alınmış (hazırlanıyor, kargoda, teslim edildi) siparişler. İade: "İade Edildi" durumundaki siparişler —
    bunlar satış adedine dahil değildir. Ödemesi tamamlanmayan ve iptal edilen siparişler sayılmaz.
</p>
