@model FethiyeCicekcisi.Web.ViewModels.Admin.AdminOccasionViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Yeni Özel Gün" : "Özel Gün Düzenle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var isEdit = Model.Id != 0;
}

<div style="max-width:640px">
    <form asp-controller="OccasionAdmin" asp-action="@(isEdit ? "Edit" : "Create")" method="post">
        @Html.AntiForgeryToken()
        @if (isEdit)
        {
            <input type="hidden" asp-for="Id" />
        }
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-500" style="font-size:.85rem"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger" style="font-size:.78rem"></span>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="DisplayOrder" class="form-label fw-500" style="font-size:.85rem"></label>
                        <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
                    </div>
                    <div class="col-md-6 d-flex align-items-end pb-1">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label" style="font-size:.85rem"></label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-dark">Kaydet</button>
            <a href="/admin/ozel-gunler" class="btn btn-outline-secondary">İptal</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
