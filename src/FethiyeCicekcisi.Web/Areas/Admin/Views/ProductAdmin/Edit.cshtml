@model FethiyeCicekcisi.Web.ViewModels.Admin.AdminProductViewModel
@{
    ViewData["Title"] = "Ürünü Düzenle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<form asp-controller="ProductAdmin" asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" data-upload-form>
    @Html.AntiForgeryToken()
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-600">Ürün Bilgileri</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-500" style="font-size:.85rem"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger" style="font-size:.78rem"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Code" class="form-label fw-500" style="font-size:.85rem"></label>
                        <input asp-for="Code" class="form-control" placeholder="Boş bırakılırsa otomatik atanır (YC-0001)" style="font-family:monospace" />
                        <span asp-validation-for="Code" class="text-danger" style="font-size:.78rem"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ShortDescription" class="form-label fw-500" style="font-size:.85rem"></label>
                        <textarea asp-for="ShortDescription" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-500" style="font-size:.85rem"></label>
                        <textarea asp-for="Description" class="form-control" rows="6"></textarea>
                    </div>
                    <div class="mb-0">
                        <label asp-for="CareInstructions" class="form-label fw-500" style="font-size:.85rem"></label>
                        <input asp-for="CareInstructions" class="form-control" placeholder="Suyu her gün tazeleyin, doğrudan güneşten koruyun..." />
                    </div>
                </div>
            </div>

            <partial name="_TranslationTabs" model="Model" />

            <!-- Variants -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-600">Seçenekler (Adet / Boy / Stok)</h6>
                    <button type="button" class="btn btn-sm btn-outline-dark" onclick="addVariant()">
                        <i class="bi bi-plus"></i> Ekle
                    </button>
                </div>
                <div class="card-body variant-scroll" id="variantsContainer">
                    <div class="row g-2 mb-2 text-muted" style="font-size:.75rem;text-transform:uppercase;letter-spacing:.05em">
                        <div class="col-4">Seçenek</div>
                        <div class="col-2">Stok</div>
                        <div class="col-2">Fiyat Farkı</div>
                        <div class="col-2">SKU</div>
                        <div class="col-1">Aktif</div>
                        <div class="col-1"></div>
                    </div>
                    @for (int i = 0; i < Model.Variants.Count; i++)
                    {
                        <div class="row g-2 mb-2 variant-row align-items-center">
                            <input type="hidden" name="Variants[@i].Id" value="@Model.Variants[i].Id" />
                            <input type="hidden" name="Variants[@i].IsDeleted" class="variant-deleted-flag" value="false" />
                            <div class="col-4"><input name="Variants[@i].Size" class="form-control form-control-sm" value="@Model.Variants[i].Size" placeholder="11 Adet, Büyük Boy..." /></div>
                            <div class="col-2"><input name="Variants[@i].StockQuantity" class="form-control form-control-sm" type="number" value="@Model.Variants[i].StockQuantity" min="0" /></div>
                            <div class="col-2"><input name="Variants[@i].PriceDifference" class="form-control form-control-sm" type="number" step="0.01" value="@Model.Variants[i].PriceDifference" placeholder="0.00" /></div>
                            <div class="col-2"><input name="Variants[@i].SKU" class="form-control form-control-sm" value="@Model.Variants[i].SKU" placeholder="-" /></div>
                            <div class="col-1 d-flex justify-content-center">
                                <input type="checkbox" name="Variants[@i].IsActive" class="form-check-input" value="true" checked="@Model.Variants[i].IsActive" />
                                <input type="hidden" name="Variants[@i].IsActive" value="false" />
                            </div>
                            <div class="col-1"><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeVariant(this)"><i class="bi bi-x"></i></button></div>
                        </div>
                    }
                </div>
                <div class="card-footer bg-white py-2">
                    <small class="text-muted" style="font-size:.75rem">Örn: "11 Adet", "21 Adet", "Büyük Boy". Fiyat farkı ana fiyata eklenir (negatif olabilir).</small>
                </div>
            </div>

            <!-- Existing Images -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-600">Mevcut Görseller</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3" id="existingImagesGrid">
                        @if (Model.ExistingImages?.Any() == true)
                        {
                            @foreach (var img in Model.ExistingImages.OrderBy(i => i.DisplayOrder))
                            {
                                <div class="col-6 col-md-3" data-image-id="@img.Id">
                                    <div class="border rounded position-relative overflow-hidden" style="aspect-ratio:3/4">
                                        <img src="@img.ImageUrl" alt="@img.AltText" style="width:100%;height:100%;object-fit:cover" />
                                        <span class="badge bg-dark position-absolute top-0 start-0 m-2 main-badge @(img.IsMain ? "" : "d-none")" style="font-size:.65rem">Ana Görsel</span>
                                    </div>
                                    <div class="d-flex gap-1 mt-2">
                                        <button type="button" class="btn btn-sm @(img.IsMain ? "btn-warning" : "btn-outline-dark") w-100 set-main-btn" style="font-size:.72rem" title="Ana görsel yap">
                                            <i class="bi @(img.IsMain ? "bi-star-fill" : "bi-star")"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger w-100 delete-image-btn" style="font-size:.72rem" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                    <p class="text-muted mb-0 @(Model.ExistingImages?.Any() == true ? "d-none" : "")" id="noImagesMsg" style="font-size:.85rem">Henüz görsel eklenmemiş.</p>

                    <hr />
                    <label class="form-label fw-500" style="font-size:.85rem">Yeni Görsel Ekle</label>
                    <input type="file" name="newImages" class="form-control" multiple accept="image/*" data-image-input />
                    <small class="text-muted">Maks 10MB / görsel. JPG, PNG, WEBP, GIF desteklenir — iPhone HEIC/HEIF fotoğrafları otomatik olarak JPEG'e dönüştürülür. Önizlemede bir görselin üzerindeki yıldıza tıklayarak onu ana görsel seçebilirsiniz.</small>
                    <div class="row g-2 mt-1" data-image-preview></div>
                    <div class="d-flex align-items-center gap-3 mt-2">
                        <button type="button" id="uploadImagesBtn" class="btn btn-dark btn-sm" style="font-size:.8rem">
                            <i class="bi bi-cloud-upload me-1"></i> Yükle
                        </button>
                        <div id="uploadStatus" class="flex-grow-1"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-600">Fiyatlandırma</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Price" class="form-label fw-500" style="font-size:.85rem"></label>
                        <div class="input-group">
                            <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
                            <span class="input-group-text">₺</span>
                        </div>
                        <span asp-validation-for="Price" class="text-danger" style="font-size:.78rem"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DiscountPrice" class="form-label fw-500" style="font-size:.85rem"></label>
                        <div class="input-group">
                            <input asp-for="DiscountPrice" class="form-control" type="number" step="0.01" min="0" />
                            <span class="input-group-text">₺</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-600">Kategori & Durum</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label fw-500" style="font-size:.85rem"></label>
                        <select asp-for="CategoryId" class="form-select">
                            <option value="">Kategori Seçin</option>
                            @foreach (var c in Model.Categories ?? Enumerable.Empty<FethiyeCicekcisi.Core.Entities.Category>())
                            {
                                <option value="@c.Id" selected="@(c.Id == Model.CategoryId)">@c.Name</option>
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger" style="font-size:.78rem"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-500" style="font-size:.85rem"></label>
                        <select asp-for="Status" class="form-select"
                                asp-items="Html.GetEnumSelectList<FethiyeCicekcisi.Core.Enums.ProductStatus>()"></select>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="IsFeatured" class="form-check-input" type="checkbox" />
                        <label asp-for="IsFeatured" class="form-check-label" style="font-size:.85rem"></label>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DisplayOrder" class="form-label fw-500" style="font-size:.85rem"></label>
                        <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-600">Çiçekçilik Özellikleri</h6>
                </div>
                <div class="card-body">
                    <div class="form-check form-switch mb-2">
                        <input asp-for="ContainsVase" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="ContainsVase" class="form-check-label" style="font-size:.85rem"></label>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input asp-for="AllowsMessageCard" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="AllowsMessageCard" class="form-check-label" style="font-size:.85rem"></label>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="IsSameDayDelivery" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="IsSameDayDelivery" class="form-check-label" style="font-size:.85rem"></label>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-600">Özel Günler</h6>
                </div>
                <div class="card-body">
                    @if (Model.Occasions?.Any() == true)
                    {
                        @foreach (var occasion in Model.Occasions)
                        {
                            <div class="form-check mb-1">
                                <input class="form-check-input" type="checkbox" name="SelectedOccasionIds" value="@occasion.Id"
                                       id="occasion-@occasion.Id" checked="@Model.SelectedOccasionIds.Contains(occasion.Id)" />
                                <label class="form-check-label" for="occasion-@occasion.Id" style="font-size:.85rem">@occasion.Name</label>
                            </div>
                        }
                    }
                    else
                    {
                        <small class="text-muted">Henüz özel gün tanımlanmamış. <a href="/admin/ozel-gunler/ekle">Ekle →</a></small>
                    }
                </div>
            </div>

            <button type="submit" class="btn btn-dark w-100">Değişiklikleri Kaydet</button>
            <a href="/admin/urunler" class="btn btn-outline-secondary w-100 mt-2">İptal</a>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        let variantCount = @Model.Variants.Count;
        function addVariant() {
            const idx = variantCount++;
            const container = document.getElementById('variantsContainer');
            const div = document.createElement('div');
            div.className = 'row g-2 mb-2 variant-row align-items-center';
            div.innerHTML = `
                <input type="hidden" name="Variants[${idx}].Id" value="0" />
                <input type="hidden" name="Variants[${idx}].IsDeleted" class="variant-deleted-flag" value="false" />
                <div class="col-4"><input name="Variants[${idx}].Size" class="form-control form-control-sm" placeholder="11 Adet, Büyük Boy..." /></div>
                <div class="col-2"><input name="Variants[${idx}].StockQuantity" class="form-control form-control-sm" type="number" value="0" min="0" /></div>
                <div class="col-2"><input name="Variants[${idx}].PriceDifference" class="form-control form-control-sm" type="number" step="0.01" placeholder="0.00" /></div>
                <div class="col-2"><input name="Variants[${idx}].SKU" class="form-control form-control-sm" placeholder="-" /></div>
                <div class="col-1 d-flex justify-content-center">
                    <input type="checkbox" name="Variants[${idx}].IsActive" class="form-check-input" value="true" checked />
                    <input type="hidden" name="Variants[${idx}].IsActive" value="false" />
                </div>
                <div class="col-1"><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeVariant(this)"><i class="bi bi-x"></i></button></div>
            `;
            container.appendChild(div);
        }

        function removeVariant(btn) {
            const row = btn.closest('.variant-row');
            const idInput = row.querySelector('input[name$=".Id"]');
            if (idInput && idInput.value !== '0') {
                // Existing (already-saved) variant: keep it in the form so it still posts,
                // just flag it deleted and hide it — the server soft-deletes on submit.
                row.querySelector('.variant-deleted-flag').value = 'true';
                row.style.display = 'none';
            } else {
                row.remove();
            }
        }
    </script>

    <script>
        // Görsel yönetimi: mevcut görsellerde yıldız/sil artık tam sayfa reload'u olan
        // <form> post'u değil, fetch ile DOM'u yerinde güncelleyen AJAX çağrıları. Yeni
        // eklenen (henüz yüklenmemiş) görsellerin önizlemesine de bir yıldız eklenir —
        // hangisi seçiliyse "Yükle"ye basıldığında o dosya ana görsel olarak kaydedilir.
        (function () {
            const productId = @Model.Id;
            const grid = document.getElementById('existingImagesGrid');
            const noImagesMsg = document.getElementById('noImagesMsg');
            const fileInput = document.querySelector('input[name="newImages"][data-image-input]');
            const preview = document.querySelector('[data-image-preview]');
            const uploadBtn = document.getElementById('uploadImagesBtn');
            const uploadStatus = document.getElementById('uploadStatus');
            if (!grid || !fileInput || !preview || !uploadBtn) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            let pendingMainIndex = 0;

            function existingImageMarkup(id, url, isMain) {
                return `
                    <div class="border rounded position-relative overflow-hidden" style="aspect-ratio:3/4">
                        <img src="${url}" alt="" style="width:100%;height:100%;object-fit:cover" />
                        <span class="badge bg-dark position-absolute top-0 start-0 m-2 main-badge ${isMain ? '' : 'd-none'}" style="font-size:.65rem">Ana Görsel</span>
                    </div>
                    <div class="d-flex gap-1 mt-2">
                        <button type="button" class="btn btn-sm ${isMain ? 'btn-warning' : 'btn-outline-dark'} w-100 set-main-btn" style="font-size:.72rem" title="Ana görsel yap">
                            <i class="bi ${isMain ? 'bi-star-fill' : 'bi-star'}"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger w-100 delete-image-btn" style="font-size:.72rem" title="Sil">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>`;
            }

            function wireImageActions(col) {
                col.querySelector('.set-main-btn')?.addEventListener('click', async function () {
                    const imageId = col.dataset.imageId;
                    this.disabled = true;
                    try {
                        const res = await fetch(`/admin/urunler/gorsel-ana-yap/${imageId}`, {
                            method: 'POST',
                            headers: { 'RequestVerificationToken': token },
                            body: new URLSearchParams({ productId })
                        });
                        const data = await res.json();
                        if (!data.success) { uploadStatus.innerHTML = '<span class="text-danger" style="font-size:.8rem">Ana görsel güncellenemedi.</span>'; return; }
                        grid.querySelectorAll('[data-image-id]').forEach(el => {
                            const isMain = el === col;
                            el.querySelector('.main-badge')?.classList.toggle('d-none', !isMain);
                            const btn = el.querySelector('.set-main-btn');
                            btn.className = `btn btn-sm ${isMain ? 'btn-warning' : 'btn-outline-dark'} w-100 set-main-btn`;
                            btn.querySelector('i').className = `bi ${isMain ? 'bi-star-fill' : 'bi-star'}`;
                        });
                    } catch { uploadStatus.innerHTML = '<span class="text-danger" style="font-size:.8rem">Ana görsel güncellenemedi.</span>'; }
                    finally { this.disabled = false; }
                });

                col.querySelector('.delete-image-btn')?.addEventListener('click', async function () {
                    if (!confirm('Bu görseli silmek istediğinize emin misiniz?')) return;
                    const imageId = col.dataset.imageId;
                    this.disabled = true;
                    try {
                        const res = await fetch(`/admin/urunler/gorsel-sil/${imageId}`, {
                            method: 'POST',
                            headers: { 'RequestVerificationToken': token },
                            body: new URLSearchParams({ productId })
                        });
                        const data = await res.json();
                        if (!data.success) { uploadStatus.innerHTML = '<span class="text-danger" style="font-size:.8rem">Görsel silinemedi.</span>'; this.disabled = false; return; }
                        col.remove();
                        if (!grid.querySelector('[data-image-id]')) noImagesMsg?.classList.remove('d-none');
                    } catch { uploadStatus.innerHTML = '<span class="text-danger" style="font-size:.8rem">Görsel silinemedi.</span>'; this.disabled = false; }
                });
            }

            grid.querySelectorAll('[data-image-id]').forEach(wireImageActions);

            function appendExistingImage(img) {
                if (img.isMain) {
                    grid.querySelectorAll('[data-image-id]').forEach(el => {
                        el.querySelector('.main-badge')?.classList.add('d-none');
                        const btn = el.querySelector('.set-main-btn');
                        if (btn) {
                            btn.className = 'btn btn-sm btn-outline-dark w-100 set-main-btn';
                            btn.querySelector('i').className = 'bi bi-star';
                        }
                    });
                }
                const col = document.createElement('div');
                col.className = 'col-6 col-md-3';
                col.dataset.imageId = img.id;
                col.innerHTML = existingImageMarkup(img.id, img.url, img.isMain);
                grid.appendChild(col);
                wireImageActions(col);
                noImagesMsg?.classList.add('d-none');
            }

            // Yeni görsel önizlemesine yıldız ekleme — _AdminLayout'taki paylaşılan
            // renderPreview() her değişiklikte preview'ı sıfırdan çizdiği için, o çizimden
            // sonra devreye girmek üzere bir MutationObserver kullanılıyor.
            function injectPendingStars() {
                if (pendingMainIndex >= preview.children.length) pendingMainIndex = 0;
                Array.from(preview.children).forEach((col, idx) => {
                    if (col.querySelector('.pending-star-btn') || col.querySelector('.bi-exclamation-triangle')) return;
                    const box = col.querySelector('div');
                    if (!box) return;
                    box.classList.add('position-relative');
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'pending-star-btn btn btn-sm btn-light border position-absolute bottom-0 start-0 m-1 p-0 d-flex align-items-center justify-content-center rounded-circle';
                    btn.style.cssText = 'width:26px;height:26px';
                    btn.title = 'Ana görsel olarak seç';
                    btn.addEventListener('click', () => { pendingMainIndex = idx; refreshPendingStars(); });
                    box.appendChild(btn);
                });
                refreshPendingStars();
            }

            function refreshPendingStars() {
                Array.from(preview.children).forEach((col, idx) => {
                    const btn = col.querySelector('.pending-star-btn');
                    if (!btn) return;
                    btn.innerHTML = idx === pendingMainIndex
                        ? '<i class="bi bi-star-fill text-warning"></i>'
                        : '<i class="bi bi-star text-muted"></i>';
                });
            }

            new MutationObserver(injectPendingStars).observe(preview, { childList: true });

            uploadBtn.addEventListener('click', async function () {
                const files = Array.from(fileInput.files || []);
                if (!files.length) { uploadStatus.innerHTML = '<span class="text-danger" style="font-size:.8rem">Önce görsel seçin.</span>'; return; }

                uploadBtn.disabled = true;
                uploadBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Yükleniyor...';
                uploadStatus.innerHTML = '';

                const formData = new FormData();
                files.forEach(f => formData.append('files', f));
                formData.append('mainIndex', pendingMainIndex);

                try {
                    const res = await fetch(`/admin/urunler/duzenle/${productId}/gorsel-yukle`, {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': token },
                        body: formData
                    });
                    const data = await res.json();

                    (data.images || []).forEach(appendExistingImage);
                    if (data.images?.length) {
                        fileInput.value = '';
                        preview.innerHTML = '';
                        pendingMainIndex = 0;
                    }

                    if (data.errors?.length) {
                        uploadStatus.innerHTML = `<div class="alert alert-warning py-2 px-3 mb-0" style="font-size:.8rem">${data.errors.length} görsel yüklenemedi:<br>${data.errors.map(e => '• ' + e).join('<br>')}</div>`;
                    } else if (data.images?.length) {
                        uploadStatus.innerHTML = `<span class="text-success" style="font-size:.82rem"><i class="bi bi-check-circle me-1"></i>${data.images.length} görsel yüklendi.</span>`;
                    }
                } catch (err) {
                    uploadStatus.innerHTML = '<div class="alert alert-danger py-2 px-3 mb-0" style="font-size:.8rem">Yükleme başarısız: ' + (err?.message || 'bağlantı hatası') + '</div>';
                } finally {
                    uploadBtn.disabled = false;
                    uploadBtn.innerHTML = '<i class="bi bi-cloud-upload me-1"></i> Yükle';
                }
            });
        })();
    </script>

    <partial name="_ValidationScriptsPartial" />
}
