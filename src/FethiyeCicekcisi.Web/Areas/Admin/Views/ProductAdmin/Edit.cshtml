@model FethiyeCicekcisi.Web.ViewModels.Admin.AdminProductViewModel
@{
    ViewData["Title"] = "Ürünü Düzenle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<form asp-controller="ProductAdmin" asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" data-upload-form>
    @Html.AntiForgeryToken()
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-600">Ürün Bilgileri</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-500" style="font-size:.85rem"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger" style="font-size:.78rem"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Code" class="form-label fw-500" style="font-size:.85rem"></label>
                        <input asp-for="Code" class="form-control" placeholder="Boş bırakılırsa otomatik atanır (YC-0001)" style="font-family:monospace" />
                        <span asp-validation-for="Code" class="text-danger" style="font-size:.78rem"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ShortDescription" class="form-label fw-500" style="font-size:.85rem"></label>
                        <textarea asp-for="ShortDescription" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-500" style="font-size:.85rem"></label>
                        <textarea asp-for="Description" class="form-control" rows="6"></textarea>
                    </div>
                    <div class="mb-0">
                        <label asp-for="CareInstructions" class="form-label fw-500" style="font-size:.85rem"></label>
                        <input asp-for="CareInstructions" class="form-control" placeholder="Suyu her gün tazeleyin, doğrudan güneşten koruyun..." />
                    </div>
                </div>
            </div>

            <!-- Variants -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-600">Seçenekler (Adet / Boy / Stok)</h6>
                    <button type="button" class="btn btn-sm btn-outline-dark" onclick="addVariant()">
                        <i class="bi bi-plus"></i> Ekle
                    </button>
                </div>
                <div class="card-body variant-scroll" id="variantsContainer">
                    <div class="row g-2 mb-2 text-muted" style="font-size:.75rem;text-transform:uppercase;letter-spacing:.05em">
                        <div class="col-4">Seçenek</div>
                        <div class="col-2">Stok</div>
                        <div class="col-2">Fiyat Farkı</div>
                        <div class="col-2">SKU</div>
                        <div class="col-1">Aktif</div>
                        <div class="col-1"></div>
                    </div>
                    @for (int i = 0; i < Model.Variants.Count; i++)
                    {
                        <div class="row g-2 mb-2 variant-row align-items-center">
                            <input type="hidden" name="Variants[@i].Id" value="@Model.Variants[i].Id" />
                            <input type="hidden" name="Variants[@i].IsDeleted" class="variant-deleted-flag" value="false" />
                            <div class="col-4"><input name="Variants[@i].Size" class="form-control form-control-sm" value="@Model.Variants[i].Size" placeholder="11 Adet, Büyük Boy..." /></div>
                            <div class="col-2"><input name="Variants[@i].StockQuantity" class="form-control form-control-sm" type="number" value="@Model.Variants[i].StockQuantity" min="0" /></div>
                            <div class="col-2"><input name="Variants[@i].PriceDifference" class="form-control form-control-sm" type="number" step="0.01" value="@Model.Variants[i].PriceDifference" placeholder="0.00" /></div>
                            <div class="col-2"><input name="Variants[@i].SKU" class="form-control form-control-sm" value="@Model.Variants[i].SKU" placeholder="-" /></div>
                            <div class="col-1 d-flex justify-content-center">
                                <input type="checkbox" name="Variants[@i].IsActive" class="form-check-input" value="true" checked="@Model.Variants[i].IsActive" />
                                <input type="hidden" name="Variants[@i].IsActive" value="false" />
                            </div>
                            <div class="col-1"><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeVariant(this)"><i class="bi bi-x"></i></button></div>
                        </div>
                    }
                </div>
                <div class="card-footer bg-white py-2">
                    <small class="text-muted" style="font-size:.75rem">Örn: "11 Adet", "21 Adet", "Büyük Boy". Fiyat farkı ana fiyata eklenir (negatif olabilir).</small>
                </div>
            </div>

            <!-- Existing Images -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-600">Mevcut Görseller</h6>
                </div>
                <div class="card-body">
                    @if (Model.ExistingImages?.Any() == true)
                    {
                        <div class="row g-3">
                            @foreach (var img in Model.ExistingImages.OrderBy(i => i.DisplayOrder))
                            {
                                <div class="col-6 col-md-3">
                                    <div class="border rounded position-relative overflow-hidden" style="aspect-ratio:3/4">
                                        <img src="@img.ImageUrl" alt="@img.AltText" style="width:100%;height:100%;object-fit:cover" />
                                        @if (img.IsMain)
                                        {
                                            <span class="badge bg-dark position-absolute top-0 start-0 m-2" style="font-size:.65rem">Ana Görsel</span>
                                        }
                                    </div>
                                    <div class="d-flex gap-1 mt-2">
                                        @if (!img.IsMain)
                                        {
                                            <form asp-controller="ProductAdmin" asp-action="SetMainImage" asp-route-imageId="@img.Id" method="post" class="flex-grow-1">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="productId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-dark w-100" style="font-size:.72rem" title="Ana görsel yap">
                                                    <i class="bi bi-star"></i>
                                                </button>
                                            </form>
                                        }
                                        <form asp-controller="ProductAdmin" asp-action="DeleteImage" asp-route-imageId="@img.Id" method="post"
                                              onsubmit="return confirm('Bu görseli silmek istediğinize emin misiniz?')" class="flex-grow-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger w-100" style="font-size:.72rem" title="Sil">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0" style="font-size:.85rem">Henüz görsel eklenmemiş.</p>
                    }

                    <hr />
                    <label class="form-label fw-500" style="font-size:.85rem">Yeni Görsel Ekle</label>
                    <input type="file" name="newImages" class="form-control" multiple accept="image/*" capture="environment" data-image-input />
                    <small class="text-muted">Hiç görsel yoksa ilk yüklenen ana görsel olarak ayarlanır. Maks 10MB / görsel. JPG, PNG, WEBP, GIF desteklenir — iPhone HEIC/HEIF fotoğrafları otomatik olarak JPEG'e dönüştürülür.</small>
                    <div class="row g-2 mt-1" data-image-preview></div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-600">Fiyatlandırma</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Price" class="form-label fw-500" style="font-size:.85rem"></label>
                        <div class="input-group">
                            <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
                            <span class="input-group-text">₺</span>
                        </div>
                        <span asp-validation-for="Price" class="text-danger" style="font-size:.78rem"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DiscountPrice" class="form-label fw-500" style="font-size:.85rem"></label>
                        <div class="input-group">
                            <input asp-for="DiscountPrice" class="form-control" type="number" step="0.01" min="0" />
                            <span class="input-group-text">₺</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-600">Kategori & Durum</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label fw-500" style="font-size:.85rem"></label>
                        <select asp-for="CategoryId" class="form-select">
                            <option value="">Kategori Seçin</option>
                            @foreach (var c in Model.Categories ?? Enumerable.Empty<FethiyeCicekcisi.Core.Entities.Category>())
                            {
                                <option value="@c.Id" selected="@(c.Id == Model.CategoryId)">@c.Name</option>
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger" style="font-size:.78rem"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-500" style="font-size:.85rem"></label>
                        <select asp-for="Status" class="form-select"
                                asp-items="Html.GetEnumSelectList<FethiyeCicekcisi.Core.Enums.ProductStatus>()"></select>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="IsFeatured" class="form-check-input" type="checkbox" />
                        <label asp-for="IsFeatured" class="form-check-label" style="font-size:.85rem"></label>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DisplayOrder" class="form-label fw-500" style="font-size:.85rem"></label>
                        <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-600">Çiçekçilik Özellikleri</h6>
                </div>
                <div class="card-body">
                    <div class="form-check form-switch mb-2">
                        <input asp-for="ContainsVase" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="ContainsVase" class="form-check-label" style="font-size:.85rem"></label>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input asp-for="AllowsMessageCard" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="AllowsMessageCard" class="form-check-label" style="font-size:.85rem"></label>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="IsSameDayDelivery" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="IsSameDayDelivery" class="form-check-label" style="font-size:.85rem"></label>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-600">Özel Günler</h6>
                </div>
                <div class="card-body">
                    @if (Model.Occasions?.Any() == true)
                    {
                        @foreach (var occasion in Model.Occasions)
                        {
                            <div class="form-check mb-1">
                                <input class="form-check-input" type="checkbox" name="SelectedOccasionIds" value="@occasion.Id"
                                       id="occasion-@occasion.Id" checked="@Model.SelectedOccasionIds.Contains(occasion.Id)" />
                                <label class="form-check-label" for="occasion-@occasion.Id" style="font-size:.85rem">@occasion.Name</label>
                            </div>
                        }
                    }
                    else
                    {
                        <small class="text-muted">Henüz özel gün tanımlanmamış. <a href="/admin/ozel-gunler/ekle">Ekle →</a></small>
                    }
                </div>
            </div>

            <button type="submit" class="btn btn-dark w-100">Değişiklikleri Kaydet</button>
            <a href="/admin/urunler" class="btn btn-outline-secondary w-100 mt-2">İptal</a>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        let variantCount = @Model.Variants.Count;
        function addVariant() {
            const idx = variantCount++;
            const container = document.getElementById('variantsContainer');
            const div = document.createElement('div');
            div.className = 'row g-2 mb-2 variant-row align-items-center';
            div.innerHTML = `
                <input type="hidden" name="Variants[${idx}].Id" value="0" />
                <input type="hidden" name="Variants[${idx}].IsDeleted" class="variant-deleted-flag" value="false" />
                <div class="col-4"><input name="Variants[${idx}].Size" class="form-control form-control-sm" placeholder="11 Adet, Büyük Boy..." /></div>
                <div class="col-2"><input name="Variants[${idx}].StockQuantity" class="form-control form-control-sm" type="number" value="0" min="0" /></div>
                <div class="col-2"><input name="Variants[${idx}].PriceDifference" class="form-control form-control-sm" type="number" step="0.01" placeholder="0.00" /></div>
                <div class="col-2"><input name="Variants[${idx}].SKU" class="form-control form-control-sm" placeholder="-" /></div>
                <div class="col-1 d-flex justify-content-center">
                    <input type="checkbox" name="Variants[${idx}].IsActive" class="form-check-input" value="true" checked />
                    <input type="hidden" name="Variants[${idx}].IsActive" value="false" />
                </div>
                <div class="col-1"><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeVariant(this)"><i class="bi bi-x"></i></button></div>
            `;
            container.appendChild(div);
        }

        function removeVariant(btn) {
            const row = btn.closest('.variant-row');
            const idInput = row.querySelector('input[name$=".Id"]');
            if (idInput && idInput.value !== '0') {
                // Existing (already-saved) variant: keep it in the form so it still posts,
                // just flag it deleted and hide it — the server soft-deletes on submit.
                row.querySelector('.variant-deleted-flag').value = 'true';
                row.style.display = 'none';
            } else {
                row.remove();
            }
        }
    </script>
    <partial name="_ValidationScriptsPartial" />
}
