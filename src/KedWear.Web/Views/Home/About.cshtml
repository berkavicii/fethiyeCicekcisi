@{
    ViewData["Title"] = "Hakkımızda";
}

<section class="bg-beige">
    <div class="container text-center" style="padding-top:5rem;padding-bottom:5rem">
        <p class="section-tag">Hikayemiz</p>
        <h1 class="section-title mb-3">Küçük bir atölye,<br><em>büyük bir özen</em></h1>
        <p class="text-muted mx-auto" style="max-width:520px;font-size:.95rem;font-weight:300">Şık, kaliteli ve uygun fiyatlı moda — herkes için.</p>
    </div>
</section>

<div class="container py-5" style="max-width:720px">
    <p class="mb-4" style="font-size:1.05rem;line-height:1.9;font-weight:300">KedWear, kaliteli kıyafet ve çantaları herkesin erişebileceği fiyatlarla sunmak amacıyla kurulmuş bir moda markasıdır. Her koleksiyonumuzda şıklığı ve konforu bir arada sunmayı hedefliyoruz.</p>
    <p class="mb-5" style="font-size:1.05rem;line-height:1.9;font-weight:300">Ürünlerimiz, titizlikle seçilmiş kumaşlar ve malzemelerden üretilmektedir. Müşteri memnuniyeti en büyük önceliğimizdir.</p>

    <hr class="mx-auto mb-5" style="max-width:80px;border-color:var(--kw-border);opacity:1" />

    <div class="row g-5 mt-1">
        <div class="col-md-4 text-center reveal">
            <i class="bi bi-bag-heart fs-2 mb-3 d-block" style="color:var(--kw-accent)"></i>
            <h6 class="fw-500 mb-2" style="font-family:var(--font-serif);font-size:1.1rem">Kaliteli Ürünler</h6>
            <p class="text-muted" style="font-size:.86rem">Özenle seçilmiş kumaşlar ve işçilik</p>
        </div>
        <div class="col-md-4 text-center reveal" style="transition-delay:.1s">
            <i class="bi bi-truck fs-2 mb-3 d-block" style="color:var(--kw-accent)"></i>
            <h6 class="fw-500 mb-2" style="font-family:var(--font-serif);font-size:1.1rem">Hızlı Teslimat</h6>
            <p class="text-muted" style="font-size:.86rem">500₺ üzeri siparişlerde ücretsiz kargo</p>
        </div>
        <div class="col-md-4 text-center reveal" style="transition-delay:.2s">
            <i class="bi bi-arrow-counterclockwise fs-2 mb-3 d-block" style="color:var(--kw-accent)"></i>
            <h6 class="fw-500 mb-2" style="font-family:var(--font-serif);font-size:1.1rem">Kolay İade</h6>
            <p class="text-muted" style="font-size:.86rem">14 gün içinde ücretsiz iade</p>
        </div>
    </div>
</div>
