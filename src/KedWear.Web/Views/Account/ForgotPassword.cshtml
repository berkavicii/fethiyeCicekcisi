@model KedWear.Web.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Şifremi Unuttum";
}

<div class="container py-5 text-center" style="max-width:440px">
    <h1 class="section-title mb-2">Şifremi Unuttum</h1>
    <p class="text-muted mb-5" style="font-size:.88rem">E-posta adresinizi girin, şifre sıfırlama bağlantısı gönderelim.</p>

    @if (TempData["Success"] is string msg)
    {
        <div class="alert alert-success mb-4" style="font-size:.85rem">@msg</div>
    }

    <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="text-start">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="font-size:.85rem"></div>
        <div class="mb-4">
            <label asp-for="Email" class="form-label" style="font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em"></label>
            <input asp-for="Email" class="form-control form-control-kw" type="email" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger" style="font-size:.78rem"></span>
        </div>
        <button type="submit" class="btn-kw-dark w-100 border-0">Gönder</button>
    </form>

    <p class="text-center mt-4" style="font-size:.85rem">
        <a asp-controller="Account" asp-action="Login">← Giriş Yap</a>
    </p>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
