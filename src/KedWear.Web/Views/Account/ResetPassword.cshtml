@model KedWear.Web.ViewModels.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "Şifre Sıfırla";
}

<div class="container py-5 text-center" style="max-width:440px">
    <h1 class="section-title mb-2">Yeni Şifre Belirle</h1>
    <p class="text-muted mb-5" style="font-size:.88rem">Hesabınız için yeni bir şifre girin.</p>

    <form asp-controller="Account" asp-action="ResetPassword" method="post" class="text-start">
        @Html.AntiForgeryToken()
        <input asp-for="Token" type="hidden" />
        <input asp-for="Email" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="font-size:.85rem"></div>
        <div class="mb-4">
            <label asp-for="Password" class="form-label" style="font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em"></label>
            <input asp-for="Password" class="form-control form-control-kw" type="password" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger" style="font-size:.78rem"></span>
        </div>
        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="form-label" style="font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em"></label>
            <input asp-for="ConfirmPassword" class="form-control form-control-kw" type="password" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:.78rem"></span>
        </div>
        <button type="submit" class="btn-kw-dark w-100 border-0">Şifremi Sıfırla</button>
    </form>

    <p class="text-center mt-4" style="font-size:.85rem">
        <a asp-controller="Account" asp-action="Login">← Giriş Yap</a>
    </p>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
