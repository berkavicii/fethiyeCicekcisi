@model KedWear.Core.Entities.Order
@{
    ViewData["Title"] = "Ödeme Başarılı";
}

<div class="container py-5 text-center" style="max-width:600px">
    <div class="mb-4">
        <i class="bi bi-check-circle-fill text-success" style="font-size:4rem"></i>
    </div>
    <h2 class="section-title mb-2">Teşekkürler!</h2>
    <p class="text-muted mb-4">Siparişiniz başarıyla alındı. Sipariş numaranız: <strong>@Model.OrderNumber</strong></p>

    <div class="order-summary-box text-start mb-4">
        @foreach (var item in Model.Items)
        {
            <div class="d-flex justify-content-between mb-2" style="font-size:.88rem">
                <span>@item.ProductName <small class="text-muted">× @item.Quantity</small></span>
                <span>@item.TotalPrice.ToString("N2") ₺</span>
            </div>
        }
        <hr />
        <div class="d-flex justify-content-between">
            <strong>Toplam</strong>
            <strong>@Model.TotalAmount.ToString("N2") ₺</strong>
        </div>
    </div>

    <div class="d-flex gap-3 justify-content-center">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Order" asp-action="MyOrders" class="btn-kw-outline">Siparişlerim</a>
        }
        <a asp-controller="Home" asp-action="Index" class="btn-kw-dark">Ana Sayfaya Dön</a>
    </div>
</div>
