@model KedWear.Web.ViewModels.Order.CheckoutViewModel
@{
    ViewData["Title"] = "Ödeme";
}

<div class="container py-5">
    <h1 class="section-title mb-5">Ödeme</h1>

    <form asp-controller="Order" asp-action="Checkout" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-5">
            <!-- Shipping Form -->
            <div class="col-lg-7">
                <h5 class="mb-4" style="font-family:var(--font-serif)">Teslimat Bilgileri</h5>

                @if (Model.SavedAddresses?.Any() == true)
                {
                    <div class="mb-4">
                        <label class="form-label" style="font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em">Kayıtlı Adresler</label>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var addr in Model.SavedAddresses)
                            {
                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                        onclick="fillAddress('@addr.FirstName','@addr.LastName','@addr.Phone','@addr.AddressLine1','@addr.City','@addr.District')">
                                    @addr.Title
                                </button>
                            }
                        </div>
                    </div>
                }

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label fw-500" style="font-size:.82rem"></label>
                        <input asp-for="FirstName" class="form-control form-control-kw" />
                        <span asp-validation-for="FirstName" class="text-danger" style="font-size:.78rem"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label fw-500" style="font-size:.82rem"></label>
                        <input asp-for="LastName" class="form-control form-control-kw" />
                        <span asp-validation-for="LastName" class="text-danger" style="font-size:.78rem"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-500" style="font-size:.82rem"></label>
                        <input asp-for="Email" class="form-control form-control-kw" type="email" />
                        <span asp-validation-for="Email" class="text-danger" style="font-size:.78rem"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-500" style="font-size:.82rem"></label>
                        <input asp-for="Phone" class="form-control form-control-kw" />
                        <span asp-validation-for="Phone" class="text-danger" style="font-size:.78rem"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="AddressLine1" class="form-label fw-500" style="font-size:.82rem"></label>
                        <input asp-for="AddressLine1" class="form-control form-control-kw" id="addrLine1" />
                        <span asp-validation-for="AddressLine1" class="text-danger" style="font-size:.78rem"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="AddressLine2" class="form-label fw-500" style="font-size:.82rem"></label>
                        <input asp-for="AddressLine2" class="form-control form-control-kw" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="City" class="form-label fw-500" style="font-size:.82rem"></label>
                        <input asp-for="City" class="form-control form-control-kw" id="addrCity" />
                        <span asp-validation-for="City" class="text-danger" style="font-size:.78rem"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="District" class="form-label fw-500" style="font-size:.82rem"></label>
                        <input asp-for="District" class="form-control form-control-kw" id="addrDistrict" />
                        <span asp-validation-for="District" class="text-danger" style="font-size:.78rem"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Notes" class="form-label fw-500" style="font-size:.82rem"></label>
                        <textarea asp-for="Notes" class="form-control form-control-kw" rows="3"></textarea>
                    </div>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="SaveAddress" class="form-check-input" type="checkbox" />
                                <label asp-for="SaveAddress" class="form-check-label" style="font-size:.85rem">Bu adresi kaydet</label>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Order Summary -->
            <div class="col-lg-5">
                <div class="order-summary-box">
                    <h5 class="mb-4" style="font-family:var(--font-serif)">Sipariş Özeti</h5>
                    @foreach (var item in Model.CartItems)
                    {
                        <div class="d-flex gap-3 mb-3">
                            <img src="@(item.Product?.MainImageUrl ?? "/images/products/placeholder.jpg")"
                                 style="width:60px;height:75px;object-fit:cover;background:#f5f0e8" alt="@item.Product?.Name"
                                 onerror="this.src='/images/products/placeholder.jpg'" />
                            <div class="flex-grow-1">
                                <div style="font-size:.85rem;font-weight:500">@item.Product?.Name</div>
                                @if (item.ProductVariant != null || !string.IsNullOrEmpty(item.PantSize))
                                {
                                    <small class="text-muted">@item.ProductVariant?.Size @(item.PantSize ?? item.ProductVariant?.PantSize) @item.ProductVariant?.Color</small>
                                }
                                <div class="d-flex justify-content-between mt-1">
                                    <small class="text-muted">× @item.Quantity</small>
                                    <small class="fw-500">@item.TotalPrice.ToString("N2") ₺</small>
                                </div>
                            </div>
                        </div>
                    }
                    <hr />
                    <div class="d-flex justify-content-between mb-2" style="font-size:.9rem">
                        <span>Ara Toplam</span>
                        <span>@Model.SubTotal.ToString("N2") ₺</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3" style="font-size:.9rem">
                        <span>Kargo</span>
                        <span>@(Model.ShippingCost == 0 ? "Ücretsiz" : Model.ShippingCost.ToString("N2") + " ₺")</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between mb-4">
                        <span class="fw-600">Toplam</span>
                        <span class="fw-600">@Model.TotalAmount.ToString("N2") ₺</span>
                    </div>

                    <button type="submit" class="btn-kw-dark d-block w-100 border-0">
                        Ödeme Yap
                    </button>
                    <p class="text-muted text-center mt-3" style="font-size:.75rem">
                        <i class="bi bi-lock me-1"></i> Güvenli ödeme PayTR ile sağlanmaktadır.
                    </p>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function fillAddress(fn, ln, phone, addr, city, district) {
            document.getElementById('FirstName').value = fn;
            document.getElementById('LastName').value = ln;
            document.getElementById('Phone').value = phone;
            document.getElementById('addrLine1').value = addr;
            document.getElementById('addrCity').value = city;
            document.getElementById('addrDistrict').value = district;
        }
    </script>
    <partial name="_ValidationScriptsPartial" />
}
