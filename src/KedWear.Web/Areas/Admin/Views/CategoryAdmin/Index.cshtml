@model IEnumerable<KedWear.Core.Entities.Category>
@{
    ViewData["Title"] = "Kategoriler";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var categories = Model;
}

<div class="d-flex justify-content-end mb-4">
    <a href="/admin/kategoriler/ekle" class="btn btn-dark btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Yeni Kategori
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
        <table class="table table-hover mb-0" style="font-size:.87rem">
            <thead>
                <tr class="text-muted" style="font-size:.75rem;text-transform:uppercase;letter-spacing:.05em">
                    <th class="ps-3 py-3">Kategori Adı</th>
                    <th class="py-3">Slug</th>
                    <th class="py-3">Durum</th>
                    <th class="py-3">Sıra</th>
                    <th class="py-3">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in categories)
                {
                    <tr>
                        <td class="ps-3 py-3 fw-500">@cat.Name</td>
                        <td class="py-3 text-muted">@cat.Slug</td>
                        <td class="py-3">
                            <span class="status-badge @(cat.IsActive ? "status-delivered" : "status-cancelled")">
                                @(cat.IsActive ? "Aktif" : "Pasif")
                            </span>
                        </td>
                        <td class="py-3 text-muted">@cat.DisplayOrder</td>
                        <td class="py-3">
                            <div class="d-flex gap-2">
                                <a href="/admin/kategoriler/duzenle/@cat.Id" class="btn btn-sm btn-outline-dark">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form action="/admin/kategoriler/sil/@cat.Id" method="post"
                                      onsubmit="return confirm('Kategoriyi silmek istediğinize emin misiniz?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
</div>
