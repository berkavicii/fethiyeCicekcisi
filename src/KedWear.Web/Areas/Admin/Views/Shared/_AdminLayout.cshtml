<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — KedWear Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Antonio:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background:#f8f8f6">

<div class="d-flex">
    <!-- Sidebar -->
    <nav class="admin-sidebar p-3 d-none d-lg-block">
        <div class="py-3 mb-3 border-bottom border-white border-opacity-10">
            <a href="/" class="text-decoration-none d-block mb-1">
                <img src="/images/kedblack.svg" alt="KedWear" style="height:32px;width:auto;filter:invert(1)" />
            </a>
            <div class="text-white-50 mt-1" style="font-size:.72rem;letter-spacing:.1em">ADMIN PANEL</div>
        </div>

        <ul class="nav flex-column gap-1">
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                   href="/admin">
                    <i class="bi bi-grid"></i> Dashboard
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ProductAdmin" ? "active" : "")"
                   href="/admin/urunler">
                    <i class="bi bi-bag"></i> Ürünler
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CategoryAdmin" ? "active" : "")"
                   href="/admin/kategoriler">
                    <i class="bi bi-tags"></i> Kategoriler
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "OrderAdmin" ? "active" : "")"
                   href="/admin/siparisler">
                    <i class="bi bi-receipt"></i> Siparişler
                </a>
            </li>
            <li class="nav-item mt-3 border-top border-white border-opacity-10 pt-3">
                <a class="nav-link" href="/" target="_blank">
                    <i class="bi bi-box-arrow-up-right"></i> Siteye Git
                </a>
            </li>
            <li class="nav-item">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-link border-0 bg-transparent w-100 text-start">
                        <i class="bi bi-box-arrow-left"></i> Çıkış
                    </button>
                </form>
            </li>
        </ul>
    </nav>

    <!-- Content -->
    <main class="admin-content flex-grow-1">
        <!-- Top bar -->
        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
            <div>
                <h5 class="mb-0 fw-600">@ViewData["Title"]</h5>
                <small class="text-muted">@DateTime.Now.ToString("dd MMMM yyyy")</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted" style="font-size:.82rem">@User.Identity?.Name</span>
            </div>
        </div>

        @if (TempData["Success"] is string successMsg)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>@successMsg
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] is string errorMsg)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@errorMsg
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Warning"] is string warningMsg)
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle me-2"></i>@warningMsg
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Multipart forms marked data-upload-form show a submit-time overlay so the
    // admin gets feedback while large mobile photos upload over a slow connection.
    document.addEventListener('submit', function (e) {
        const form = e.target.closest('[data-upload-form]');
        if (!form) return;
        const overlay = document.createElement('div');
        overlay.style.cssText = 'position:fixed;inset:0;background:rgba(255,255,255,.85);z-index:2000;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1rem';
        overlay.innerHTML = '<div class="spinner-border" style="width:2.5rem;height:2.5rem" role="status"></div><div style="font-size:.9rem;font-weight:500">Görseller yükleniyor, lütfen bekleyin...</div>';
        document.body.appendChild(overlay);
        const submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) submitBtn.disabled = true;
    });

    // Live thumbnail preview for file inputs marked data-image-input, so the
    // admin sees exactly what's about to be uploaded, and can remove a wrongly
    // selected file before submitting. iPhone's default HEIC/HEIF photos aren't
    // decodable by ImageSharp on the server, so they're converted to JPEG right
    // here in the browser before the form ever submits — the server never sees
    // a HEIC file. Uses heic-to (actively maintained, real libheif-wasm under
    // the hood) rather than the long-abandoned heic2any, which fails on the
    // newer HEIC variants modern iPhones produce (HDR, etc).
    //
    // HEIC detection is content-based (ISO-BMFF "ftyp" box), not extension-based:
    // some iOS share/export paths hand out a file named ".jpg" whose bytes are
    // still HEIC — an extension check alone would ship that straight to the
    // server unconverted.
    const SUPPORTED_IMAGE_EXTENSIONS = ['jpg', 'jpeg', 'png', 'webp', 'gif'];
    const HEIC_BRANDS = ['heic', 'heix', 'heim', 'heis', 'hevc', 'hevm', 'hevs', 'mif1', 'msf1'];
    let heicToLoad = null;

    async function isHeicContent(file) {
        try {
            const buf = new Uint8Array(await file.slice(0, 12).arrayBuffer());
            if (buf.length < 12) return false;
            const box = String.fromCharCode(buf[4], buf[5], buf[6], buf[7]);
            if (box !== 'ftyp') return false;
            const brand = String.fromCharCode(buf[8], buf[9], buf[10], buf[11]).toLowerCase();
            return HEIC_BRANDS.includes(brand);
        } catch (err) {
            console.error('HEIC içerik kontrolü başarısız:', file.name, err);
            return false;
        }
    }

    function loadHeicTo() {
        if (window.HeicTo) return Promise.resolve();
        if (heicToLoad) return heicToLoad;
        heicToLoad = new Promise((resolve, reject) => {
            const script = document.createElement('script');
            script.src = 'https://cdn.jsdelivr.net/npm/heic-to@1.5.2/dist/iife/heic-to.js';
            script.onload = resolve;
            script.onerror = () => { heicToLoad = null; reject(new Error('heic-to kütüphanesi CDN\'den yüklenemedi')); };
            document.head.appendChild(script);
        });
        return heicToLoad;
    }

    async function convertHeicToJpeg(file) {
        await loadHeicTo();
        const blob = await window.HeicTo({ blob: file, type: 'image/jpeg', quality: 0.85 });
        const newName = file.name.replace(/\.(heic|heif)$/i, '') + '.jpg';
        return new File([blob], newName, { type: 'image/jpeg' });
    }

    function setInputFiles(input, files) {
        const dt = new DataTransfer();
        files.forEach(f => dt.items.add(f));
        input.files = dt.files;
    }

    function renderPreview(input, preview, entries) {
        preview.innerHTML = '';
        const removeBtn = index => `
            <button type="button" class="btn btn-light border position-absolute top-0 end-0 m-1 p-0 d-flex align-items-center justify-content-center rounded-circle"
                    style="width:24px;height:24px" data-remove-index="${index}" title="Kaldır">
                <i class="bi bi-x" style="font-size:.9rem"></i>
            </button>`;

        entries.forEach((entry, index) => {
            const file = entry.file;
            const ext = file.name.split('.').pop()?.toLowerCase() ?? '';
            const col = document.createElement('div');
            col.className = 'col-6 col-md-3';

            if (entry.error || !SUPPORTED_IMAGE_EXTENSIONS.includes(ext)) {
                const reason = entry.error ? entry.error : 'Dönüştürülemedi, desteklenmeyen format';
                col.innerHTML = `
                    <div class="border border-warning rounded position-relative d-flex flex-column align-items-center justify-content-center text-center p-2" style="aspect-ratio:3/4;background:#fff8e6">
                        ${removeBtn(index)}
                        <i class="bi bi-exclamation-triangle text-warning" style="font-size:1.4rem"></i>
                        <small class="mt-1" style="font-size:.7rem;word-break:break-all">${file.name}</small>
                        <small class="text-warning mt-1" style="font-size:.68rem">${reason}</small>
                    </div>`;
                preview.appendChild(col);
                return;
            }

            const url = URL.createObjectURL(file);
            col.innerHTML = `
                <div class="border rounded overflow-hidden position-relative" style="aspect-ratio:3/4">
                    ${removeBtn(index)}
                    <img src="${url}" alt="${file.name}" style="width:100%;height:100%;object-fit:cover" onload="URL.revokeObjectURL(this.src)" />
                </div>
                <small class="d-block text-muted mt-1 text-truncate" style="font-size:.7rem">${file.name}</small>`;
            preview.appendChild(col);
        });

        preview.querySelectorAll('[data-remove-index]').forEach(btn => {
            btn.addEventListener('click', () => {
                const idx = parseInt(btn.dataset.removeIndex, 10);
                const remaining = entries.filter((_, i) => i !== idx);
                setInputFiles(input, remaining.map(e => e.file));
                renderPreview(input, preview, remaining);
            });
        });
    }

    document.addEventListener('change', async function (e) {
        const input = e.target.closest('[data-image-input]');
        if (!input) return;
        const preview = input.closest('.card-body')?.querySelector('[data-image-preview]');
        if (!preview) return;

        const files = Array.from(input.files || []);
        if (!files.length) { preview.innerHTML = ''; return; }

        // Detect HEIC by real content, not just the ".heic/.heif" extension.
        const heicFlags = await Promise.all(files.map(f =>
            ['heic', 'heif'].includes(f.name.split('.').pop()?.toLowerCase()) ? Promise.resolve(true) : isHeicContent(f)
        ));
        const hasHeic = heicFlags.some(Boolean);
        if (hasHeic) {
            preview.innerHTML = '<div class="col-12 text-muted" style="font-size:.82rem"><span class="spinner-border spinner-border-sm me-2"></span>HEIC görsel(ler) JPEG\'e dönüştürülüyor...</div>';
        }

        const entries = [];
        for (let i = 0; i < files.length; i++) {
            const file = files[i];
            if (heicFlags[i]) {
                try {
                    entries.push({ file: await convertHeicToJpeg(file) });
                } catch (err) {
                    console.error('HEIC dönüşümü başarısız:', file.name, err);
                    entries.push({ file, error: 'HEIC dönüşümü başarısız: ' + (err?.message || 'bilinmeyen hata') });
                }
            } else {
                entries.push({ file });
            }
        }

        // Rebuild the input's FileList so the actual upload sends the converted
        // JPEGs — setting .files programmatically does not re-fire 'change'.
        if (hasHeic) setInputFiles(input, entries.map(e => e.file));
        renderPreview(input, preview, entries);
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
